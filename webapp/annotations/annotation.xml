<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">
    <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/Common.xml">
        <edmx:Include Namespace="com.sap.vocabularies.Common.v1" Alias="Common"/>
    </edmx:Reference>
    <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/UI.xml">
        <edmx:Include Namespace="com.sap.vocabularies.UI.v1" Alias="UI"/>
    </edmx:Reference>
    <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/Communication.xml">
        <edmx:Include Namespace="com.sap.vocabularies.Communication.v1" Alias="Communication"/>
    </edmx:Reference>
    <edmx:DataServices>
        <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="local">
            <Annotations Target="com.sap.gateway.srvd.zle_aust_sd_appl_log.v0001.AppLogType">

                <Annotation Term="UI.DataPoint" Qualifier="LogTypeStatus">
                    <Record Type="UI.DataPointType">
                        <PropertyValue Property="Value" Path="LogType"/>
                        <PropertyValue Property="Criticality" Path="LogTypeCriticality"/>
                    </Record>
                </Annotation>

                <Annotation Term="UI.LineItem">
                    <Collection>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Label" String="Zeitstempel"/>
                            <PropertyValue Property="Value" Path="CreatedAt"/>
                        </Record>
                        <Record Type="UI.DataFieldForAnnotation">
                            <PropertyValue Property="Label" String="Typ"/>
                            <PropertyValue Property="Target" AnnotationPath="@UI.DataPoint#LogTypeStatus"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Label" String="Meldung"/>
                            <PropertyValue Property="Value" Path="Message"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Label" String="Material"/>
                            <PropertyValue Property="Value" Path="ItemNumber"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Label" String="TPA-Nummer"/>
                            <PropertyValue Property="Value" Path="TpaNumber"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Label" String="Prozess"/>
                            <PropertyValue Property="Value" Path="HistoryType"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Label" String="Position"/>
                            <PropertyValue Property="Value" Path="OrderLineNr"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Label" String="HTTP-Status"/>
                            <PropertyValue Property="Value" Path="HttpStatus"/>
                        </Record>
                    </Collection>
                </Annotation>

                <Annotation Term="UI.PresentationVariant">
                    <Record Type="UI.PresentationVariantType">
                        <PropertyValue Property="MaxItems" Int="200"/>
                        <PropertyValue Property="SortOrder">
                            <Collection>
                                <Record Type="Common.SortOrderType">
                                    <PropertyValue Property="Property" PropertyPath="CreatedAt"/>
                                    <PropertyValue Property="Descending" Bool="true"/>
                                </Record>
                            </Collection>
                        </PropertyValue>
                        <PropertyValue Property="Visualizations">
                            <Collection>
                                <AnnotationPath>@UI.LineItem</AnnotationPath>
                            </Collection>
                        </PropertyValue>
                    </Record>
                </Annotation>

                <!--
                    🔴 HIER STANDEN DIE OVP-KARTEN, ENTFERNT 11.09.2026.

                    Vier Annotationen mit den Qualifiern AppLogCard und
                    AbbruchCard - LineItem, SelectionVariant und je ein
                    PresentationVariant. Sie stammten aus der Overview-Page,
                    die es seit dem Freestyle-Umbau nicht mehr gibt, und
                    wurden von keiner Stelle der App mehr gelesen (geprueft:
                    kein Treffer in view/, controller/, model/).

                    Wirkungslos waren sie, irrefuehrend nicht: die
                    SelectionVariant#AbbruchCard filterte LogType eq 'E' und
                    hielt damit im Quelltext genau die Definition von
                    "Abbruch" fest, die O-25 als FALSCH nachgewiesen hat -
                    fachliche Abbrueche liegen auf 'W'. Wer die Datei las,
                    fand die widerlegte Fassung.
                -->

            </Annotations>
        </Schema>
    </edmx:DataServices>
</edmx:Edmx>