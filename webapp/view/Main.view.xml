<mvc:View
	controllerName="zui5_zle_aust_mon.controller.Main"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
	xmlns:t="sap.ui.table"
	xmlns:rm="sap.ui.table.rowmodes"
	xmlns:viz="sap.viz.ui5.controls"
	xmlns:vizData="sap.viz.ui5.data"
	xmlns:vizFeeds="sap.viz.ui5.controls.common.feeds">
	<f:DynamicPage id="mainPage" headerExpanded="true" showFooter="false">

		<f:title>
			<f:DynamicPageTitle id="mainTitle">
				<f:heading>
					<HBox id="titleBox" alignItems="Center">
						<Avatar
							id="titleAvatar"
							src="sap-icon://overview-chart"
							displaySize="S"
							backgroundColor="Accent6"
							class="sapUiTinyMarginEnd"/>
						<VBox id="titleTextBox">
							<Title id="appTitleText" text="{i18n>appTitle}" level="H1"/>
							<Text id="appSubtitleText" text="{i18n>appSubTitle}"/>
						</VBox>
					</HBox>
				</f:heading>
				<f:actions>
					<ObjectStatus
						id="idLastRefreshObjectStatus"
						icon="sap-icon://history"
						text="{i18n>lastRefreshLabel} {ui>/lastRefreshText}"/>
					<Button
						id="navTasksButton"
						icon="sap-icon://task"
						text="{i18n>navToTasks}"
						tooltip="{i18n>tasksTitle}"
						type="Transparent"
						press=".onNavToTasks"/>
					<Button
						id="refreshButton"
						icon="sap-icon://refresh"
						tooltip="{i18n>refreshTooltip}"
						type="Transparent"
						press=".onRefresh"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>

		<f:content>
			<!--
				Je Gruppe ein eigener GridContainer, gestapelt in einer VBox.
				Damit ist "Chart oben" strukturell erzwungen statt durch eine
				Sortierkonvention. Kein dragDropConfig an den Grids -> die
				Anordnung ist fuer den Anwender nicht verschiebbar
				(Feedback-Punkt 6). Eine GridContainerSettings-Instanz laesst
				sich NICHT zwischen Layouts teilen, deshalb steht sie je Grid
				und Breakpoint einzeln im XML.

					Raster: fest 12 Spalten, die zwischen minColumnSize und
					maxColumnSize atmen - dadurch fuellen die Panels die
					verfuegbare Breite randlos aus. Ein festes columnSize waere
					hier falsch (12 Spalten haetten dann immer dieselbe
					Pixelbreite, egal wie breit der Container ist) und ist laut
					API ohnehin nicht mit min-/maxColumnSize kombinierbar.
					Die Breite selbst deckelt zleContentMaxWidth auf 1280px.
					rowSize und gap bleiben unveraendert, damit die
					minRows-Rechnung der Panels weiter gilt.
			-->
			<VBox id="groupContainer" class="zleContentMaxWidth sapUiMediumMarginTop sapUiMediumMarginBottom" renderType="Bare">

				<core:Fragment fragmentName="zui5_zle_aust_mon.view.fragment.KontaktBar" type="XML"/>

				<Title id="overviewHeading" text="{i18n>groupOverview}" level="H2" titleStyle="H2" class="sapUiLargeMarginTop sapUiSmallMarginBottom"/>
				<f:GridContainer id="overviewGrid" snapToRow="true">
					<f:layout>
						<f:GridContainerSettings columns="12" minColumnSize="4rem" maxColumnSize="6rem" rowSize="2rem" gap="1rem"/>
					</f:layout>
					<f:layoutM>
						<f:GridContainerSettings columns="4" minColumnSize="3.5rem" maxColumnSize="6rem" rowSize="2rem" gap="0.75rem"/>
					</f:layoutM>
					<f:layoutS>
						<f:GridContainerSettings columns="4" minColumnSize="3.5rem" maxColumnSize="6rem" rowSize="2rem" gap="0.75rem"/>
					</f:layoutS>

					<!--
						BEWUSST OHNE height="100%" - anders als bei allen anderen Panels.
						Der Default von sap.m.Panel.height ist "auto", damit waechst das
						Panel mit seinem Inhalt und minRows wirkt wie vorgesehen als
						Untergrenze ("the MINIMUM number of rows, which the item should
						take"). Mit height="100%" waere das Panel starr auf die
						Grid-Item-Hoehe genagelt und die Inhaltsflaeche bekaeme eine
						Bildlaufleiste, sobald der Inhalt hoeher ist - genau das war hier
						der Fall, weil sap.m.NumericContent als Tile-Control mit Label
						rund 85-90px braucht, nicht die von mir angesetzten 60px.

						Bei den Tabellen-Panels ist height="100%" dagegen notwendig: der
						rowMode Auto berechnet die Zeilenzahl aus der Containerhoehe. Beim
						chartPanel ebenso, weil der VizFrame einen begrenzten Elternteil
						braucht.
					-->
					<Panel id="kpiPanel">
						<layoutData>
							<!--
								Flache Zeile ueber die volle Breite. minRows ist hier nur der
								Boden - die tatsaechliche Hoehe ergibt sich aus dem Inhalt.
							-->
							<f:GridContainerItemLayoutData columns="12" minRows="4"/>
						</layoutData>
						<headerToolbar>
							<OverflowToolbar id="kpiToolbar" height="3.25rem">
								<Avatar id="kpiAvatar" src="sap-icon://kpi-corporate-performance" displaySize="XS" backgroundColor="Accent8"/>
								<Title id="kpiTitle" text="{i18n>kpiPanelTitle}" level="H3" titleStyle="H3"/>
								<ToolbarSpacer id="kpiSpacer"/>
							</OverflowToolbar>
						</headerToolbar>
						<content>
							<!--
								Alle vier Werte in EINER Zeile, gleichmaessig ueber die Breite
								verteilt. Zahlen kommen aus model/KpiLoader.ts (serverseitiges
								$count), Filter und Pfade unveraendert aus der frueheren
								OVP-Karte - damit sich die Werte gegenueber dem alten Stand nicht
								still aendern. Jede Zahl mit Icon, nicht nur mit Farbe.
							-->
							<HBox id="idKpiHBox" justifyContent="SpaceAround" alignItems="Center" class="sapUiSmallMargin">
								<VBox id="idGesamtVBox" alignItems="Center">
									<NumericContent
										id="idGesamtNumericContent"
										value="{ui>/kpi/gesamt}"
										icon="sap-icon://sum"
										withMargin="false"/>
									<Label id="idGesamtLabel" text="{i18n>kpiGesamt}" design="Bold"/>
								</VBox>
								<VBox id="idOffenVBox" alignItems="Center">
									<NumericContent
										id="idOffenNumericContent"
										value="{ui>/kpi/offen}"
										icon="sap-icon://pending"
										valueColor="Critical"
										withMargin="false"/>
									<Label id="idOffenLabel" text="{i18n>kpiOffen}" design="Bold"/>
								</VBox>
								<VBox id="idStorniertVBox" alignItems="Center">
									<NumericContent
										id="idStorniertNumericContent"
										value="{ui>/kpi/storniert}"
										icon="sap-icon://cancel"
										valueColor="Critical"
										withMargin="false"/>
									<Label id="idStorniertLabel" text="{i18n>kpiStorniert}" design="Bold"/>
								</VBox>
								<VBox id="idFehlerVBox" alignItems="Center">
									<NumericContent
										id="idFehlerNumericContent"
										value="{ui>/kpi/fehler}"
										icon="sap-icon://error"
										valueColor="Error"
										withMargin="false"/>
									<Label id="idFehlerLabel" text="{i18n>kpiFehler}" design="Bold"/>
								</VBox>
							</HBox>
						</content>
					</Panel>

					<Panel id="chartPanel" height="100%">
						<layoutData>
							<f:GridContainerItemLayoutData columns="12" minRows="12"/>
						</layoutData>
						<headerToolbar>
							<OverflowToolbar id="chartToolbar" height="3.25rem">
								<Avatar id="chartAvatar" src="sap-icon://vertical-bar-chart" displaySize="XS" backgroundColor="Accent6"/>
								<Title
									id="chartTitle"
									text="{parts: ['i18n>chartPanelTitle', 'ui>/chartDays'], formatter: '.formatter.chartTitle'}"
									level="H3"
									titleStyle="H3"/>
								<ToolbarSpacer id="chartSpacer"/>
								<SegmentedButton
									id="idChartDays"
									selectedKey="{ui>/chartDays}"
									selectionChange=".onChartDaysChange"
									tooltip="{i18n>chartDaysTooltip}">
									<items>
										<SegmentedButtonItem id="idChartDays7"  key="7"  text="{i18n>chartDays7}"/>
										<SegmentedButtonItem id="idChartDays14" key="14" text="{i18n>chartDays14}"/>
										<SegmentedButtonItem id="idChartDays30" key="30" text="{i18n>chartDays30}"/>
									</items>
								</SegmentedButton>
								<ObjectStatus
									id="idChartTruncatedObjectStatus"
									state="Warning"
									icon="sap-icon://alert"
									text="{i18n>chartTruncated}"
									visible="{ui>/chartTruncated}"/>
							</OverflowToolbar>
						</headerToolbar>
						<content>
							<!--
								Gestapeltes Saeulendiagramm ueber den gewaehlten Zeitraum
								(7, 14 oder 30 Tage, siehe SegmentedButton oben).
								Bewusst VizFrame und NICHT sap.ui.comp.smartchart: das vom
								Kollegen verlinkte SmartChart-Sample setzt OData V2 mit
								sap:semantics="aggregate", sap:aggregation-role und
								UI.Chart-Annotationen voraus. Unser Service ist V4 und hat
								keine davon (s. CLAUDE.md, Abschnitt UI-Redesign).

								Die Namen von Dimension und Measures stehen als Literale und
								nicht als i18n-Verweis: FeedItem/values referenziert sie
								ueber genau diese Zeichenketten, und die App hat ohnehin nur
								ein Sprachbuendel (supportedLocales: [""]).
							-->
							<viz:VizFrame
								id="idTrendVizFrame"
								vizType="stacked_column"
								width="100%"
								height="100%"
								uiConfig="{applicationSet:'fiori'}">
								<viz:dataset>
									<vizData:FlattenedDataset data="{chart>/days}">
										<vizData:dimensions>
											<vizData:DimensionDefinition name="Tag" value="{chart>label}"/>
										</vizData:dimensions>
										<vizData:measures>
											<vizData:MeasureDefinition name="Fehler" value="{chart>error}"/>
											<vizData:MeasureDefinition name="Warnungen" value="{chart>warning}"/>
											<vizData:MeasureDefinition name="Erfolg" value="{chart>success}"/>
										</vizData:measures>
									</vizData:FlattenedDataset>
								</viz:dataset>
								<viz:feeds>
									<vizFeeds:FeedItem uid="valueAxis" type="Measure" values="Fehler,Warnungen,Erfolg"/>
									<vizFeeds:FeedItem uid="categoryAxis" type="Dimension" values="Tag"/>
								</viz:feeds>
							</viz:VizFrame>
						</content>
					</Panel>
				</f:GridContainer>

				<Title id="msgHeading" text="{i18n>groupMessages}" level="H2" titleStyle="H2" class="sapUiLargeMarginTop sapUiSmallMarginBottom"/>
				<f:GridContainer id="msgGrid" snapToRow="true">
					<f:layout>
						<f:GridContainerSettings columns="12" minColumnSize="4rem" maxColumnSize="6rem" rowSize="2rem" gap="1rem"/>
					</f:layout>
					<f:layoutM>
						<f:GridContainerSettings columns="4" minColumnSize="3.5rem" maxColumnSize="6rem" rowSize="2rem" gap="0.75rem"/>
					</f:layoutM>
					<f:layoutS>
						<f:GridContainerSettings columns="4" minColumnSize="3.5rem" maxColumnSize="6rem" rowSize="2rem" gap="0.75rem"/>
					</f:layoutS>

					<!--
						EINE Tabelle fuer alle Meldungsreiter, beim Reiterwechsel neu
						gefiltert - nicht eine Tabelle je Reiter. Grund: IconTabBar laedt
						NICHT von allein verzoegert, nicht gewaehlte Reiter werden trotzdem
						instanziiert. Sechs Tabellen hiessen sechs OData-Bindungen beim
						Seitenaufbau.

						Die Auftragstabelle ist die Ausnahme: sie haengt an einer anderen
						Entitaet (tpaModel>/Tpa) und wird ueber visible umgeschaltet, damit
						trotzdem immer nur eine gebunden ist.

						Die Reiter kommen aus model/ProcessAxis.ts. Ein vierter Prozess ist
						dort eine Zeile - hier ein IconTabFilter, sonst nichts.

						⚠ stretchContentHeight + applyContentPadding=false sind nicht
						kosmetisch: rowMode Auto berechnet die Zeilenzahl aus der
						Containerhoehe. Ohne sie bekommt die Tabelle zwei Zeilen oder die
						Seite zwei Scrollbalken.
					-->
					<Panel id="msgPanel" height="100%">
						<layoutData>
							<f:GridContainerItemLayoutData columns="12" minRows="15"/>
						</layoutData>
						<content>
							<IconTabBar
								id="idProcessTabBar"
								selectedKey="{ui>/selectedProcess}"
								select=".onProcessTabSelect"
								stretchContentHeight="true"
								applyContentPadding="false"
								expandable="false">
								<items>
									<IconTabFilter
										id="idTabIB"
										key="IB"
										icon="sap-icon://download-from-cloud"
										design="Horizontal"
										text="{i18n>tabIB}"
										count="{parts: ['ui>/grouped', 'ui>/kpi/tabIB'], formatter: '.formatter.tabCount'}"/>
									<IconTabFilter
										id="idTabOB"
										key="OB"
										icon="sap-icon://upload-to-cloud"
										design="Horizontal"
										text="{i18n>tabOB}"
										count="{parts: ['ui>/grouped', 'ui>/kpi/tabOB'], formatter: '.formatter.tabCount'}"/>
									<IconTabFilter
										id="idTabITEM"
										key="ITEM"
										icon="sap-icon://product"
										design="Horizontal"
										text="{i18n>tabITEM}"
										count="{parts: ['ui>/grouped', 'ui>/kpi/tabITEM'], formatter: '.formatter.tabCount'}"/>
									<IconTabFilter
										id="idTabNONE"
										key="NONE"
										icon="sap-icon://question-mark"
										design="Horizontal"
										text="{i18n>tabNONE}"
										count="{parts: ['ui>/grouped', 'ui>/kpi/tabNONE'], formatter: '.formatter.tabCount'}"/>
									<IconTabFilter
										id="idTabALL"
										key="ALL"
										icon="sap-icon://activity-items"
										design="Horizontal"
										text="{i18n>tabALL}"
										count="{parts: ['ui>/grouped', 'ui>/kpi/tabALL'], formatter: '.formatter.tabCount'}"/>
									<IconTabFilter
										id="idTabTPA"
										key="TPA"
										icon="sap-icon://shipping-status"
										design="Horizontal"
										text="{i18n>tabTPA}"
										count="{ui>/kpi/gesamt}"/>
									<!--
										Die Pruefsicht steht bewusst als eigener Reiter und nicht als Panel:
										sie ist keine Meldungsliste, sondern eine Sicht auf SAP-Daten - der
										Typfilter E/W/S gilt fuer sie nicht.
									-->
									<IconTabFilter
										id="idTabWACHECK"
										key="WACHECK"
										icon="sap-icon://alert"
										design="Horizontal"
										text="{i18n>tabWaCheck}"
										count="{ui>/waCheckCount}"/>
								</items>
								<content>
									<OverflowToolbar id="idMsgToolbar" height="3rem">
										<SegmentedButton
											id="idTypeFilter"
											selectedKey="{ui>/selectedType}"
											selectionChange=".onTypeFilterChange"
											visible="{path: 'ui>/selectedProcess', formatter: '.formatter.isMessageView'}">
											<items>
												<SegmentedButtonItem id="idTypeAll" key="" text="{i18n>typeAll}"/>
												<SegmentedButtonItem id="idTypeE" key="E" text="{i18n>typeE}"/>
												<SegmentedButtonItem id="idTypeW" key="W" text="{i18n>typeW}"/>
												<SegmentedButtonItem id="idTypeS" key="S" text="{i18n>typeS}"/>
											</items>
										</SegmentedButton>
										<SearchField
											id="idMsgSearch"
											value="{ui>/searchTerm}"
											width="16rem"
											placeholder="{i18n>searchPlaceholder}"
											tooltip="{i18n>searchTooltip}"
											search=".onMsgSearch"
											visible="{path: 'ui>/selectedProcess', formatter: '.formatter.isMessageView'}"/>
										<ToggleButton
											id="idCascadeToggle"
											icon="sap-icon://group-2"
											text="{i18n>cascToggle}"
											tooltip="{i18n>cascToggleTooltip}"
											pressed="{ui>/grouped}"
											press=".onCascadeToggle"
											visible="{path: 'ui>/selectedProcess', formatter: '.formatter.isMessageView'}"/>
										<Text
											id="idCascadeSummary"
											text="{cascade>/summary}"
											visible="{= ${ui>/grouped} === true }"
											class="sapUiSmallMarginBegin"/>
										<ToolbarSpacer id="idMsgToolbarSpacer"/>
										<Button
											id="idMsgColumnsButton"
											icon="sap-icon://action-settings"
											tooltip="{i18n>columnsTooltip}"
											type="Transparent"
											press=".onOpenMsgColumns"/>
									</OverflowToolbar>

									<t:Table
										id="idMsgTable"
										visible="{parts: ['ui>/selectedProcess', 'ui>/grouped'], formatter: '.formatter.showMsgTable'}"
										rows="{path: 'mainModel>/AppLog', parameters: {$count: true}, sorter: [{path: 'CreatedAtStamp', descending: true}, {path: 'SeqNr', descending: true}]}"
										selectionMode="None"
										ariaLabelledBy="msgHeading">
										<t:rowMode>
											<rm:Auto maxRowCount="14"/>
										</t:rowMode>
										<t:noData>
											<IllustratedMessage
												id="idMsgNoData"
												illustrationType="{= ${ui>/searchTerm} ? 'sapIllus-NoSearchResults' : 'sapIllus-NoEntries' }"
												title="{= ${ui>/searchTerm} ? ${i18n>noDataSearchTitle} : ${i18n>noDataMsgTitle} }"
												description="{= ${ui>/searchTerm} ? ${i18n>noDataSearchText} : ${i18n>noDataMsgText} }"/>
										</t:noData>
										<t:columns>
																			<t:Column id="idMsgCreatedAtColumn" width="11.5rem" sortProperty="CreatedAtStamp">
																				<Label id="msLblCreatedAt" text="{i18n>colCreatedAt}"/>
																				<t:template>
																					<Text id="msTxtCreatedAt" text="{path: 'mainModel>CreatedAtStamp', formatter: '.formatter.timestamp'}" wrapping="false"/>
																				</t:template>
																			</t:Column>
											<t:Column id="idMsgTypeColumn" width="7rem" sortProperty="LogType">
																				<Label id="msLblLogType" text="{i18n>colLogType}"/>
																				<t:template>
																					<ObjectStatus
																						id="idMsgTypeObjectStatus"
																						text="{mainModel>LogType}"
																						state="{path: 'mainModel>LogType', formatter: '.formatter.logTypeState'}"
																						icon="{path: 'mainModel>LogType', formatter: '.formatter.logTypeIcon'}"/>
																				</t:template>
																			</t:Column>
																			<t:Column id="idMsgMessageColumn" minWidth="320">
																				<Label id="msLblMessage" text="{i18n>colMessage}"/>
																				<t:template>
																					<HBox id="msBoxMessage" alignItems="Center">
																						<Text id="msTxtMessage" text="{path: 'mainModel>Message', formatter: '.formatter.messageShort'}" wrapping="false" tooltip="{mainModel>Message}"/>
																						<!--
																							core:Icon statt sap.m.Link: Link hat KEINE
																							icon-Eigenschaft, das Symbol wurde nie
																							gerendert. Ein Button waere die Alternative,
																							erhoeht in einer Tabellenzeile aber die
																							Zeilenhoehe.

																							⚠ targetType: 'any' ist Pflicht. Eine
																							Ausdrucksbindung wandelt die referenzierte
																							Eigenschaft VOR der Auswertung in den Typ der
																							Zieleigenschaft - hier boolean. UI5 versuchte
																							also, den JSON-Payload nach boolean zu
																							konvertieren, und warf je Zeile eine
																							FormatException.
																						-->
																						<core:Icon
																							id="msIcnPayload"
																							src="sap-icon://attachment"
																							decorative="false"
																							visible="{= !!${path: 'mainModel>JsonPayload', targetType: 'any'} }"
																							tooltip="{i18n>popPayloadHint}"
																							press=".onMessagePayloadPress"
																							class="sapUiTinyMarginBegin"/>
																					</HBox>
																				</t:template>
																			</t:Column>
																			<t:Column id="idMsgItemColumn" width="12rem" sortProperty="ItemNumber">
																				<Label id="msLblItemNumber" text="{i18n>colItemNumber}"/>
																				<t:template>
																					<Link id="msTxtItemNumber" text="{path: 'mainModel>ItemNumber', formatter: '.formatter.materialNumber'}" wrapping="false" press=".onItemNumberPress" tooltip="{i18n>popTooltipItem}"/>
																				</t:template>
																			</t:Column>
																			<t:Column id="idMsgTpaColumn" width="11rem" sortProperty="TpaNumber">
																				<Label id="msLblTpaNumber" text="{i18n>colTpaNumber}"/>
																				<t:template>
																					<Link id="msTxtTpaNumber" text="{path: 'mainModel>TpaNumber', formatter: '.formatter.dashIfEmpty'}" wrapping="false" press=".onTpaNumberPress" tooltip="{i18n>popTooltipTpa}"/>
																				</t:template>
																			</t:Column>
																			<t:Column id="idMsgHistoryColumn" width="10rem" sortProperty="HistoryType">
																				<Label id="msLblHistoryType" text="{i18n>colHistoryType}"/>
																				<t:template>
																					<Text id="msTxtHistoryType" text="{mainModel>HistoryType}" wrapping="false"/>
																				</t:template>
																			</t:Column>
																			<t:Column id="idMsgLineColumn" width="7rem">
																				<Label id="msLblOrderLineNr" text="{i18n>colOrderLineNr}"/>
																				<t:template>
																					<Text id="msTxtOrderLineNr" text="{mainModel>OrderLineNr}" wrapping="false"/>
																				</t:template>
																			</t:Column>
																			<t:Column id="idMsgHttpColumn" width="7rem" hAlign="End">
																				<Label id="msLblHttpStatus" text="{i18n>colHttpStatus}"/>
																				<t:template>
																					<Text id="msTxtHttpStatus" text="{mainModel>HttpStatus}" wrapping="false"/>
																				</t:template>
																			</t:Column>
																			<t:Column id="idMsgCorrColumn" width="13rem" sortProperty="CorrUuid">
																				<Label id="msLblCorr" text="{i18n>colCorrUuid}"/>
																				<t:template>
																					<Text id="msTxtCorr" text="{path: 'mainModel>CorrUuid', formatter: '.formatter.dashIfEmpty'}" wrapping="false"/>
																				</t:template>
																			</t:Column>
																			<t:Column id="idMsgBusKeyColumn" width="12rem" sortProperty="BusinessKey">
																				<Label id="msLblBusKey" text="{i18n>colBusinessKey}"/>
																				<t:template>
																					<Text id="msTxtBusKey" text="{path: 'mainModel>BusinessKey', formatter: '.formatter.dashIfEmpty'}" wrapping="false"/>
																				</t:template>
																			</t:Column>
																			<t:Column id="idMsgKeyTypeColumn" width="8rem" sortProperty="KeyType">
																				<Label id="msLblKeyType" text="{i18n>colKeyType}"/>
																				<t:template>
																					<Text id="msTxtKeyType" text="{path: 'mainModel>KeyType', formatter: '.formatter.keyTypeText'}" wrapping="false"/>
																				</t:template>
																			</t:Column>
																			<t:Column id="idMsgLgnumColumn" width="6rem" sortProperty="Lgnum">
																				<Label id="msLblLgnum" text="{i18n>colLgnum}"/>
																				<t:template>
																					<Text id="msTxtLgnum" text="{path: 'mainModel>Lgnum', formatter: '.formatter.dashIfEmpty'}" wrapping="false"/>
																				</t:template>
																			</t:Column>
																			<t:Column id="idMsgSeqColumn" width="6rem" hAlign="End" sortProperty="SeqNr">
																				<Label id="msLblSeq" text="{i18n>colSeqNr}"/>
																				<t:template>
																					<Text id="msTxtSeq" text="{path: 'mainModel>SeqNr', formatter: '.formatter.dashIfEmpty'}" wrapping="false"/>
																				</t:template>
																			</t:Column>
																		</t:columns>
									</t:Table>

									<!--
										EIGENE TABELLE FUER DIE VORGANGSSICHT, und das ist kein
										Zufall zweier Spaltensaetze.

										Die erste Fassung band DIESELBE Tabelle einmal auf
										mainModel>/AppLog und einmal auf cascade>/rows. Das ging
										nicht auf: die Zellen binden mit Modellpraefix
										("{mainModel>Message}"), und in der Vorgangssicht liegt
										der Zeilenkontext auf "cascade" - alle Spalten blieben
										leer ausser "Schritte". Gleiche Feldnamen genuegen nicht,
										das Modell muss auch stimmen.

										Der zweite Grund ist inhaltlich: ein Vorgang ist etwas
										anderes als eine Meldung. Position, HTTP-Status,
										Korrelations-ID oder Sequenznummer lassen sich nicht
										sinnvoll verdichten - deshalb sechs Spalten statt
										vierzehn und keine Spaltenauswahl.
									-->
									<t:Table
										id="idCascadeTable"
										visible="{parts: ['ui>/selectedProcess', 'ui>/grouped'], formatter: '.formatter.showCascadeTable'}"
										rows="{cascade>/rows}"
										selectionMode="None"
										ariaLabelledBy="msgHeading">
										<t:rowMode>
											<rm:Auto maxRowCount="14"/>
										</t:rowMode>
										<t:noData>
											<IllustratedMessage
												id="idCascadeNoData"
												illustrationType="{= ${ui>/searchTerm} ? 'sapIllus-NoSearchResults' : 'sapIllus-NoEntries' }"
												title="{= ${ui>/searchTerm} ? ${i18n>noDataSearchTitle} : ${i18n>noDataMsgTitle} }"
												description="{= ${ui>/searchTerm} ? ${i18n>noDataSearchText} : ${i18n>noDataMsgText} }"/>
										</t:noData>
										<t:columns>
											<t:Column id="idCascStampColumn" width="11.5rem" sortProperty="CreatedAtStamp">
												<Label id="cscLblStamp" text="{i18n>colCreatedAt}"/>
												<t:template>
													<Text id="cscTxtStamp" text="{path: 'cascade>CreatedAtStamp', formatter: '.formatter.timestamp'}" wrapping="false"/>
												</t:template>
											</t:Column>
											<t:Column id="idCascStepsColumn" width="6rem" hAlign="Center" sortProperty="StepCount">
												<Label id="cscLblSteps" text="{i18n>colSteps}"/>
												<t:template>
													<Link
														id="cscLnkSteps"
														text="{cascade>StepCount}"
														press=".onCascadePress"
														tooltip="{i18n>cascStepsTooltip}"/>
												</t:template>
											</t:Column>
											<t:Column id="idCascTypeColumn" width="7rem" sortProperty="LogType">
												<Label id="cscLblType" text="{i18n>colLogType}"/>
												<t:template>
													<ObjectStatus
														id="cscStaType"
														text="{cascade>LogType}"
														state="{path: 'cascade>LogType', formatter: '.formatter.logTypeState'}"
														icon="{path: 'cascade>LogType', formatter: '.formatter.logTypeIcon'}"/>
												</t:template>
											</t:Column>
											<t:Column id="idCascMessageColumn" minWidth="320">
												<Label id="cscLblMessage" text="{i18n>colMessage}"/>
												<t:template>
													<Text id="cscTxtMessage" text="{path: 'cascade>Message', formatter: '.formatter.messageShort'}" wrapping="false" tooltip="{cascade>Message}"/>
												</t:template>
											</t:Column>
											<t:Column id="idCascItemColumn" width="12rem" sortProperty="ItemNumber">
												<Label id="cscLblItem" text="{i18n>colItemNumber}"/>
												<t:template>
													<Link id="cscLnkItem" text="{path: 'cascade>ItemNumber', formatter: '.formatter.materialNumber'}" wrapping="false" press=".onItemNumberPress" tooltip="{i18n>popTooltipItem}"/>
												</t:template>
											</t:Column>
											<t:Column id="idCascTpaColumn" width="11rem" sortProperty="TpaNumber">
												<Label id="cscLblTpa" text="{i18n>colTpaNumber}"/>
												<t:template>
													<Link id="cscLnkTpa" text="{path: 'cascade>TpaNumber', formatter: '.formatter.dashIfEmpty'}" wrapping="false" press=".onTpaNumberPress" tooltip="{i18n>popTooltipTpa}"/>
												</t:template>
											</t:Column>
										</t:columns>
									</t:Table>

									<!--
										Vollstaendigkeitspruefung Warenausgang.

										🔴 Sie beantwortet, welche Pick-Auftraege HiLIS gar nicht erreichen
										KOENNEN: ZXLTOU01 verzweigt mit "elseif", also feuert bei einer TA mit
										AS-Einlagerungsposition nur der Einlagerungs-Trigger - der Pick-Zweig
										wird nie erreicht, es gibt keinen POST und keinen Logeintrag. Genau so
										blieben im August zwoelf von dreissig Pick-TAs zwei Wochen unbemerkt.

										⚠ Gebunden an ein JSON-Modell, nicht an OData: der Befund entsteht durch
										Gruppierung ueber die Positionen einer TA und laesst sich serverseitig
										nicht ausdruecken.
									-->
									<t:Table
										id="idWaCheckTable"
										visible="{= ${ui>/selectedProcess} === 'WACHECK' }"
										rows="{path: 'wacheck>/rows'}"
										selectionMode="None"
										ariaLabelledBy="msgTitle">
										<t:rowMode>
											<rm:Auto maxRowCount="12"/>
										</t:rowMode>
										<t:noData>
											<IllustratedMessage
												id="waCheckNoData"
												illustrationType="sapIllus-SuccessHighFive"
												title="{i18n>waCheckEmptyTitle}"
												description="{i18n>waCheckEmptyText}"/>
										</t:noData>
										<t:columns>
											<t:Column id="idWaCheckOrderCol" width="10rem" sortProperty="TransferOrder">
												<Label id="waLblOrder" text="{i18n>colTransferOrder}"/>
												<t:template>
													<Link id="waTxtOrder" text="{wacheck>TransferOrder}" wrapping="false" press=".onTpaNumberPress" tooltip="{i18n>popTooltipTpa}"/>
												</t:template>
											</t:Column>
											<t:Column id="idWaCheckDateCol" width="8rem" sortProperty="CreationDate">
												<Label id="waLblDate" text="{i18n>colCreationDate}"/>
												<t:template>
													<Text id="waTxtDate" text="{wacheck>CreationDate}" wrapping="false"/>
												</t:template>
											</t:Column>
											<t:Column id="idWaCheckPickCol" width="8rem" hAlign="End" sortProperty="PickItems">
												<Label id="waLblPick" text="{i18n>colPickItems}"/>
												<t:template>
													<ObjectStatus id="waTxtPick" text="{wacheck>PickItems}" state="Error"/>
												</t:template>
											</t:Column>
											<t:Column id="idWaCheckPutCol" width="8rem" hAlign="End" sortProperty="PutAwayItems">
												<Label id="waLblPut" text="{i18n>colPutAwayItems}"/>
												<t:template>
													<Text id="waTxtPut" text="{wacheck>PutAwayItems}" wrapping="false"/>
												</t:template>
											</t:Column>
											<t:Column id="idWaCheckBothCol" width="9rem">
												<Label id="waLblBoth" text="{i18n>colHasBoth}"/>
												<t:template>
													<ObjectStatus id="waTxtBoth" text="{= ${wacheck>HasBoth} ? ${i18n>waBothYes} : '' }" state="Warning"/>
												</t:template>
											</t:Column>
											<t:Column id="idWaCheckMatCol" width="18rem">
												<Label id="waLblMat" text="{i18n>colMaterials}"/>
												<t:template>
													<Text id="waTxtMat" text="{wacheck>Materials}" wrapping="false"/>
												</t:template>
											</t:Column>
										</t:columns>
									</t:Table>

									<t:Table
																	id="idTpaTable"
																			visible="{= ${ui>/selectedProcess} === 'TPA' }"
																	rows="{path: 'tpaModel>/Tpa', parameters: {$count: true}, sorter: {path: 'OrderNumber'}}"
																	selectionMode="None"
																	ariaLabelledBy="tpaTitle">
																	<t:rowMode>
																		<rm:Auto maxRowCount="12"/>
																	</t:rowMode>
																	<t:noData>
																		<IllustratedMessage
																			id="idTpaNoData"
																			illustrationType="sapIllus-NoEntries"
																			title="{i18n>noDataTpaTitle}"
																			description="{i18n>noDataTpaText}"/>
																	</t:noData>
																	<t:columns>
																		<t:Column id="idTpaOrderNumberColumn" width="10rem" sortProperty="OrderNumber">
																			<Label id="tpaLblOrderNumber" text="{i18n>colOrderNumber}"/>
																			<t:template>
																				<Link id="tpaTxtOrderNumber" text="{path: 'tpaModel>OrderNumber', formatter: '.formatter.dashIfEmpty'}" wrapping="false" press=".onTpaNumberPress" tooltip="{i18n>popTooltipTpa}"/>
																			</t:template>
																		</t:Column>
																		<t:Column id="idTpaOrderLineColumn" width="7rem">
																			<Label id="tpaLblOrderLine" text="{i18n>colOrderLineNumber}"/>
																			<t:template>
																				<Text id="tpaTxtOrderLine" text="{path: 'tpaModel>OrderLineNumber', formatter: '.formatter.dashIfEmpty'}" wrapping="false"/>
																			</t:template>
																		</t:Column>
																		<t:Column id="idTpaItemColumn" width="12rem" sortProperty="ItemNumber">
																			<Label id="tpaLblItem" text="{i18n>colItemNumber}"/>
																			<t:template>
																				<Link id="tpaTxtItem" text="{path: 'tpaModel>ItemNumber', formatter: '.formatter.materialNumber'}" wrapping="false" press=".onItemNumberPress" tooltip="{i18n>popTooltipItem}"/>
																			</t:template>
																		</t:Column>
																		<t:Column id="idTpaMengeColumn" width="8rem" hAlign="End">
																			<Label id="tpaLblMenge" text="{i18n>colMenge}"/>
																			<t:template>
																				<Text id="tpaTxtMenge" text="{path: 'tpaModel>Menge', formatter: '.formatter.quantityOrDash'}" wrapping="false"/>
																			</t:template>
																		</t:Column>
																		<t:Column id="idTpaBatchColumn" width="9rem">
																			<Label id="tpaLblBatch" text="{i18n>colBatchNumber}"/>
																			<t:template>
																				<Text id="tpaTxtBatch" text="{path: 'tpaModel>BatchNumber', formatter: '.formatter.dashIfEmpty'}" wrapping="false"/>
																			</t:template>
																		</t:Column>
																		<t:Column id="idTpaLineStatusColumn" width="10rem" sortProperty="LineStatus">
																			<Label id="tpaLblLineStatus" text="{i18n>colLineStatus}"/>
																			<t:template>
																				<ObjectStatus
																					id="idTpaLineStatusObjectStatus"
																					text="{path: 'tpaModel>LineStatus', formatter: '.formatter.dashIfEmpty'}"
																					state="{path: 'tpaModel>LineStatus', formatter: '.formatter.orderStatusState'}"
																					icon="{path: 'tpaModel>LineStatus', formatter: '.formatter.orderStatusIcon'}"/>
																			</t:template>
																		</t:Column>
																		<t:Column id="idTpaOrderStatusColumn" width="10rem" sortProperty="OrderStatus">
																			<Label id="tpaLblOrderStatus" text="{i18n>colOrderStatus}"/>
																			<t:template>
																				<Text id="tpaTxtOrderStatus" text="{path: 'tpaModel>OrderStatus', formatter: '.formatter.dashIfEmpty'}" wrapping="false"/>
																			</t:template>
																		</t:Column>
																		<t:Column id="idTpaLastSyncColumn" width="12rem" sortProperty="LastSyncAt">
																			<Label id="tpaLblLastSync" text="{i18n>colLastSyncAt}"/>
																			<t:template>
																				<Text id="tpaTxtLastSync" text="{path: 'tpaModel>LastSyncAt', formatter: '.formatter.timestamp'}" wrapping="false"/>
																			</t:template>
																		</t:Column>
																		<t:Column id="idTpaOrderTypeColumn" width="9rem">
																			<Label id="tpaLblOrderType" text="{i18n>colOrderType}"/>
																			<t:template>
																				<Text id="tpaTxtOrderType" text="{tpaModel>OrderType}" wrapping="false"/>
																			</t:template>
																		</t:Column>
																		<t:Column id="idTpaWerkColumn" width="6rem">
																			<Label id="tpaLblWerk" text="{i18n>colWerk}"/>
																			<t:template>
																				<Text id="tpaTxtWerk" text="{tpaModel>Werk}" wrapping="false"/>
																			</t:template>
																		</t:Column>
																		<t:Column id="idTpaUomColumn" width="8rem">
																			<Label id="tpaLblUom" text="{i18n>colMeasurementUnit}"/>
																			<t:template>
																				<Text id="tpaTxtUom" text="{parts: ['tpaModel>OrderNumber', 'tpaModel>OrderLineNumber', 'sapPos>/map'], formatter: '.formatter.sapUnit'}" wrapping="false"/>
																			</t:template>
																		</t:Column>
																		<t:Column id="idTpaBbdColumn" width="8rem">
																			<Label id="tpaLblBbd" text="{i18n>colBestBeforeDate}"/>
																			<t:template>
																				<Text id="tpaTxtBbd" text="{parts: ['tpaModel>OrderNumber', 'tpaModel>OrderLineNumber', 'sapPos>/map'], formatter: '.formatter.sapBestBefore'}" wrapping="false"/>
																			</t:template>
																		</t:Column>
																		<t:Column id="idTpaRefNumberColumn" width="10rem">
																			<Label id="tpaLblRefNumber" text="{i18n>colReferenceNumber}"/>
																			<t:template>
																				<Text id="tpaTxtRefNumber" text="{tpaModel>ReferenceNumber}" wrapping="false"/>
																			</t:template>
																		</t:Column>
																		<t:Column id="idTpaRefDateColumn" width="9rem">
																			<Label id="tpaLblRefDate" text="{i18n>colReferenceDate}"/>
																			<t:template>
																				<Text id="tpaTxtRefDate" text="{tpaModel>ReferenceDate}" wrapping="false"/>
																			</t:template>
																		</t:Column>
																		<t:Column id="idTpaCreationDateColumn" width="11rem">
																			<Label id="tpaLblCreationDate" text="{i18n>colCreationDate}"/>
																			<t:template>
																				<Text id="tpaTxtCreationDate" text="{path: 'tpaModel>CreationDate', formatter: '.formatter.timestamp'}" wrapping="false"/>
																			</t:template>
																		</t:Column>
																	</t:columns>
																</t:Table>
								</content>
							</IconTabBar>
						</content>
					</Panel>
				</f:GridContainer>





			</VBox>
		</f:content>

	</f:DynamicPage>
</mvc:View>
