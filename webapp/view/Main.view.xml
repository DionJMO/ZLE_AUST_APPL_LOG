<mvc:View
	controllerName="zui5_zle_aust_mon.controller.Main"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
	xmlns:t="sap.ui.table"
	xmlns:rm="sap.ui.table.rowmodes"
	xmlns:viz="sap.viz.ui5.controls"
	xmlns:vizData="sap.viz.ui5.data"
	xmlns:vizFeeds="sap.viz.ui5.controls.common.feeds">
	<f:DynamicPage id="mainPage" headerExpanded="true" showFooter="false">

		<f:title>
			<f:DynamicPageTitle id="mainTitle">
				<f:heading>
					<HBox id="titleBox" alignItems="Center">
						<Avatar
							id="titleAvatar"
							src="sap-icon://overview-chart"
							displaySize="S"
							backgroundColor="Accent6"
							class="sapUiTinyMarginEnd"/>
						<VBox id="titleTextBox">
							<Title id="appTitleText" text="{i18n>appTitle}" level="H1"/>
							<Text id="appSubtitleText" text="{i18n>appSubTitle}"/>
						</VBox>
					</HBox>
				</f:heading>
				<f:actions>
					<ObjectStatus
						id="idLastRefreshObjectStatus"
						icon="sap-icon://history"
						text="{i18n>lastRefreshLabel} {ui>/lastRefreshText}"/>
					<Button
						id="navTasksButton"
						icon="sap-icon://task"
						text="{i18n>navToTasks}"
						tooltip="{i18n>tasksTitle}"
						type="Transparent"
						press=".onNavToTasks"/>
					<Button
						id="refreshButton"
						icon="sap-icon://refresh"
						tooltip="{i18n>refreshTooltip}"
						type="Transparent"
						press=".onRefresh"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>

		<f:content>
			<!--
				Je Gruppe ein eigener GridContainer, gestapelt in einer VBox.
				Damit ist "Chart oben" strukturell erzwungen statt durch eine
				Sortierkonvention. Kein dragDropConfig an den Grids -> die
				Anordnung ist fuer den Anwender nicht verschiebbar
				(Feedback-Punkt 6). Eine GridContainerSettings-Instanz laesst
				sich NICHT zwischen Layouts teilen, deshalb steht sie je Grid
				und Breakpoint einzeln im XML.

					Raster: fest 12 Spalten, die zwischen minColumnSize und
					maxColumnSize atmen - dadurch fuellen die Panels die
					verfuegbare Breite randlos aus. Ein festes columnSize waere
					hier falsch (12 Spalten haetten dann immer dieselbe
					Pixelbreite, egal wie breit der Container ist) und ist laut
					API ohnehin nicht mit min-/maxColumnSize kombinierbar.
					Die Breite selbst deckelt zleContentMaxWidth auf 1280px.
					rowSize und gap bleiben unveraendert, damit die
					minRows-Rechnung der Panels weiter gilt.
			-->
			<VBox id="groupContainer" class="zleContentMaxWidth sapUiMediumMarginTop sapUiMediumMarginBottom" renderType="Bare">

				<core:Fragment fragmentName="zui5_zle_aust_mon.view.fragment.KontaktBar" type="XML"/>

				<Title id="overviewHeading" text="{i18n>groupOverview}" level="H2" titleStyle="H2" class="sapUiLargeMarginTop sapUiSmallMarginBottom"/>
				<f:GridContainer id="overviewGrid" snapToRow="true">
					<f:layout>
						<f:GridContainerSettings columns="12" minColumnSize="4rem" maxColumnSize="6rem" rowSize="2rem" gap="1rem"/>
					</f:layout>
					<f:layoutM>
						<f:GridContainerSettings columns="4" minColumnSize="3.5rem" maxColumnSize="6rem" rowSize="2rem" gap="0.75rem"/>
					</f:layoutM>
					<f:layoutS>
						<f:GridContainerSettings columns="4" minColumnSize="3.5rem" maxColumnSize="6rem" rowSize="2rem" gap="0.75rem"/>
					</f:layoutS>

					<!--
						BEWUSST OHNE height="100%" - anders als bei allen anderen Panels.
						Der Default von sap.m.Panel.height ist "auto", damit waechst das
						Panel mit seinem Inhalt und minRows wirkt wie vorgesehen als
						Untergrenze ("the MINIMUM number of rows, which the item should
						take"). Mit height="100%" waere das Panel starr auf die
						Grid-Item-Hoehe genagelt und die Inhaltsflaeche bekaeme eine
						Bildlaufleiste, sobald der Inhalt hoeher ist - genau das war hier
						der Fall, weil sap.m.NumericContent als Tile-Control mit Label
						rund 85-90px braucht, nicht die von mir angesetzten 60px.

						Bei den Tabellen-Panels ist height="100%" dagegen notwendig: der
						rowMode Auto berechnet die Zeilenzahl aus der Containerhoehe. Beim
						chartPanel ebenso, weil der VizFrame einen begrenzten Elternteil
						braucht.
					-->
					<Panel id="kpiPanel">
						<layoutData>
							<!--
								Flache Zeile ueber die volle Breite. minRows ist hier nur der
								Boden - die tatsaechliche Hoehe ergibt sich aus dem Inhalt.
							-->
							<f:GridContainerItemLayoutData columns="12" minRows="4"/>
						</layoutData>
						<headerToolbar>
							<OverflowToolbar id="kpiToolbar" height="3.25rem">
								<Avatar id="kpiAvatar" src="sap-icon://kpi-corporate-performance" displaySize="XS" backgroundColor="Accent8"/>
								<Title id="kpiTitle" text="{i18n>kpiPanelTitle}" level="H3" titleStyle="H3"/>
								<ToolbarSpacer id="kpiSpacer"/>
							</OverflowToolbar>
						</headerToolbar>
						<content>
							<!--
								Alle vier Werte in EINER Zeile, gleichmaessig ueber die Breite
								verteilt. Zahlen kommen aus model/KpiLoader.ts (serverseitiges
								$count), Filter und Pfade unveraendert aus der frueheren
								OVP-Karte - damit sich die Werte gegenueber dem alten Stand nicht
								still aendern. Jede Zahl mit Icon, nicht nur mit Farbe.
							-->
							<HBox id="idKpiHBox" justifyContent="SpaceAround" alignItems="Center" class="sapUiSmallMargin">
								<VBox id="idGesamtVBox" alignItems="Center">
									<NumericContent
										id="idGesamtNumericContent"
										value="{ui>/kpi/gesamt}"
										icon="sap-icon://sum"
										withMargin="false"/>
									<Label id="idGesamtLabel" text="{i18n>kpiGesamt}" design="Bold"/>
								</VBox>
								<VBox id="idOffenVBox" alignItems="Center">
									<NumericContent
										id="idOffenNumericContent"
										value="{ui>/kpi/offen}"
										icon="sap-icon://pending"
										valueColor="Critical"
										withMargin="false"/>
									<Label id="idOffenLabel" text="{i18n>kpiOffen}" design="Bold"/>
								</VBox>
								<VBox id="idFehlerVBox" alignItems="Center">
									<NumericContent
										id="idFehlerNumericContent"
										value="{ui>/kpi/fehler}"
										icon="sap-icon://error"
										valueColor="Error"
										withMargin="false"/>
									<Label id="idFehlerLabel" text="{i18n>kpiFehler}" design="Bold"/>
								</VBox>
								<VBox id="idAbbruecheVBox" alignItems="Center">
									<NumericContent
										id="idAbbruecheNumericContent"
										value="{ui>/kpi/abbrueche}"
										icon="sap-icon://cancel"
										valueColor="Critical"
										withMargin="false"/>
									<Label id="idAbbruecheLabel" text="{i18n>kpiAbbrueche}" design="Bold"/>
								</VBox>
							</HBox>
						</content>
					</Panel>

					<Panel id="chartPanel" height="100%">
						<layoutData>
							<f:GridContainerItemLayoutData columns="12" minRows="12"/>
						</layoutData>
						<headerToolbar>
							<OverflowToolbar id="chartToolbar" height="3.25rem">
								<Avatar id="chartAvatar" src="sap-icon://vertical-bar-chart" displaySize="XS" backgroundColor="Accent6"/>
								<Title id="chartTitle" text="{i18n>chartPanelTitle}" level="H3" titleStyle="H3"/>
								<ToolbarSpacer id="chartSpacer"/>
								<ObjectStatus
									id="idChartTruncatedObjectStatus"
									state="Warning"
									icon="sap-icon://alert"
									text="{i18n>chartTruncated}"
									visible="{ui>/chartTruncated}"/>
							</OverflowToolbar>
						</headerToolbar>
						<content>
							<!--
								Gestapeltes Saeulendiagramm ueber die letzten sieben Tage.
								Bewusst VizFrame und NICHT sap.ui.comp.smartchart: das vom
								Kollegen verlinkte SmartChart-Sample setzt OData V2 mit
								sap:semantics="aggregate", sap:aggregation-role und
								UI.Chart-Annotationen voraus. Unser Service ist V4 und hat
								keine davon (s. CLAUDE.md, Abschnitt UI-Redesign).

								Die Namen von Dimension und Measures stehen als Literale und
								nicht als i18n-Verweis: FeedItem/values referenziert sie
								ueber genau diese Zeichenketten, und die App hat ohnehin nur
								ein Sprachbuendel (supportedLocales: [""]).
							-->
							<viz:VizFrame
								id="idTrendVizFrame"
								vizType="stacked_column"
								width="100%"
								height="100%"
								uiConfig="{applicationSet:'fiori'}">
								<viz:dataset>
									<vizData:FlattenedDataset data="{chart>/days}">
										<vizData:dimensions>
											<vizData:DimensionDefinition name="Tag" value="{chart>label}"/>
										</vizData:dimensions>
										<vizData:measures>
											<vizData:MeasureDefinition name="Fehler" value="{chart>error}"/>
											<vizData:MeasureDefinition name="Warnungen" value="{chart>warning}"/>
											<vizData:MeasureDefinition name="Erfolg" value="{chart>success}"/>
										</vizData:measures>
									</vizData:FlattenedDataset>
								</viz:dataset>
								<viz:feeds>
									<vizFeeds:FeedItem uid="valueAxis" type="Measure" values="Fehler,Warnungen,Erfolg"/>
									<vizFeeds:FeedItem uid="categoryAxis" type="Dimension" values="Tag"/>
								</viz:feeds>
							</viz:VizFrame>
						</content>
					</Panel>
				</f:GridContainer>

				<Title id="dataHeading" text="{i18n>groupInbound}" level="H2" titleStyle="H2" class="sapUiLargeMarginTop sapUiSmallMarginBottom"/>
				<f:GridContainer id="dataGrid" snapToRow="true">
					<f:layout>
						<f:GridContainerSettings columns="12" minColumnSize="4rem" maxColumnSize="6rem" rowSize="2rem" gap="1rem"/>
					</f:layout>
					<f:layoutM>
						<f:GridContainerSettings columns="4" minColumnSize="3.5rem" maxColumnSize="6rem" rowSize="2rem" gap="0.75rem"/>
					</f:layoutM>
					<f:layoutS>
						<f:GridContainerSettings columns="4" minColumnSize="3.5rem" maxColumnSize="6rem" rowSize="2rem" gap="0.75rem"/>
					</f:layoutS>


					<!--
						PROZESSACHSE Wareneingang. Ausgewaehlt wird ueber den Praefix von
						HistoryType ("IB_"), nicht ueber Textmuster in der Meldung: der
						Praefix ist der einzige strukturierte Prozesstraeger, den die
						Tabelle hat (IB_ Wareneingang, OB_ Warenausgang, ITEM_
						Materialstamm). Der Filter laeuft serverseitig als
						startswith(HistoryType,'IB_').

						Anders als die Panels der Gruppe "Meldungen nach Typ" zeigt dieses
						ALLE Meldungstypen - E, W und S nebeneinander. Das ist der Sinn der
						Prozesssicht: was passiert im Wareneingang, unabhaengig davon, wie
						schlimm es ist. Die Typ-Spalte traegt den Zustand.

						⚠ Die Liste ist unvollstaendig, solange das Backend HISTORY_TYPE
						nicht durchgaengig setzt (alle WM-Trigger-Pfade und alle
						HTTP-Fehler aus BASE lassen es leer, siehe CLAUDE.md O-27). Der
						zweite Zaehler in der Kopfzeile macht genau diese Luecke sichtbar,
						statt sie zu verstecken - er zaehlt die Saetze ohne
						Prozesszuordnung, die in KEINER Prozessgruppe erscheinen koennen.
					-->
					<Panel id="inboundMsgPanel" height="100%">
						<layoutData>
							<!-- Siehe appLogPanel: Panelhoehe passend zu maxRowCount=12. -->
							<f:GridContainerItemLayoutData columns="12" minRows="11"/>
						</layoutData>
						<headerToolbar>
							<OverflowToolbar id="inboundMsgToolbar" height="3.25rem">
								<Avatar id="inboundMsgAvatar" src="sap-icon://download-from-cloud" displaySize="XS" backgroundColor="Accent7"/>
								<Title id="inboundMsgTitle" text="{i18n>inboundMsgPanelTitle}" level="H3" titleStyle="H3"/>
								<ToolbarSpacer id="inboundMsgSpacer"/>
								<ObjectStatus
									id="idInboundMsgCountObjectStatus"
									state="Information"
									icon="sap-icon://message-information"
									text="{ui>/kpi/weMeldungen} {i18n>inboundMsgPanelHint}"/>
								<ObjectStatus
									id="idNoProcessCountInStatus"
									state="Warning"
									icon="sap-icon://alert"
									text="{ui>/kpi/ohneProzess} {i18n>noProcessHint}"/>
								<Button
									id="inboundMsgColumnsButton"
									icon="sap-icon://action-settings"
									tooltip="{i18n>columnsTooltip}"
									type="Transparent"
									press=".onOpenInboundMsgColumns"/>
							</OverflowToolbar>
						</headerToolbar>
						<content>
							<t:Table
								id="idInboundMsgTable"
								rows="{path: 'mainModel>/AppLog', parameters: {$count: true}, filters: {and: false, filters: [{path: 'HistoryType', operator: 'StartsWith', value1: 'IB_'}, {path: 'Message', operator: 'Contains', value1: 'PutAway'}]}, sorter: {path: 'CreatedAt', descending: true}}"
								selectionMode="None"
								ariaLabelledBy="inboundMsgTitle">
								<t:rowMode>
									<rm:Auto maxRowCount="12"/>
								</t:rowMode>
								<t:columns>
									<t:Column id="idInboundMsgCreatedAtColumn" width="8rem" sortProperty="CreatedAt">
										<Label id="imLblCreatedAt" text="{i18n>colCreatedAt}"/>
										<t:template>
											<Text id="imTxtCreatedAt" text="{mainModel>CreatedAt}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idInboundMsgTypeColumn" width="7rem" sortProperty="LogType">
										<Label id="imLblLogType" text="{i18n>colLogType}"/>
										<t:template>
											<ObjectStatus
												id="idInboundMsgTypeObjectStatus"
												text="{mainModel>LogType}"
												state="{path: 'mainModel>LogType', formatter: '.formatter.logTypeState'}"
												icon="{path: 'mainModel>LogType', formatter: '.formatter.logTypeIcon'}"/>
										</t:template>
									</t:Column>
									<t:Column id="idInboundMsgMessageColumn" minWidth="320">
										<Label id="imLblMessage" text="{i18n>colMessage}"/>
										<t:template>
											<Text id="imTxtMessage" text="{path: 'mainModel>Message', formatter: '.formatter.messageShort'}" wrapping="false" tooltip="{mainModel>Message}"/>
										</t:template>
									</t:Column>
									<t:Column id="idInboundMsgItemColumn" width="12rem" sortProperty="ItemNumber">
										<Label id="imLblItem" text="{i18n>colItemNumber}"/>
										<t:template>
											<Text id="imTxtItem" text="{path: 'mainModel>ItemNumber', formatter: '.formatter.dashIfEmpty'}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idInboundMsgTpaColumn" width="11rem" sortProperty="TpaNumber">
										<Label id="imLblTpa" text="{i18n>colTpaNumber}"/>
										<t:template>
											<Text id="imTxtTpa" text="{path: 'mainModel>TpaNumber', formatter: '.formatter.dashIfEmpty'}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idInboundMsgProcessColumn" width="10rem" sortProperty="HistoryType">
										<Label id="imLblHistory" text="{i18n>colHistoryType}"/>
										<t:template>
											<Text id="imTxtHistory" text="{mainModel>HistoryType}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idInboundMsgLineColumn" width="7rem">
										<Label id="imLblLine" text="{i18n>colOrderLineNr}"/>
										<t:template>
											<Text id="imTxtLine" text="{path: 'mainModel>OrderLineNr', formatter: '.formatter.dashIfEmpty'}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idInboundMsgHttpColumn" width="7rem" hAlign="End" sortProperty="HttpStatus">
										<Label id="imLblHttp" text="{i18n>colHttpStatus}"/>
										<t:template>
											<Text id="imTxtHttp" text="{mainModel>HttpStatus}" wrapping="false"/>
										</t:template>
									</t:Column>
								</t:columns>
							</t:Table>
						</content>
					</Panel>

					<Panel id="tpaPanel" height="100%">
						<layoutData>
							<!-- Siehe appLogPanel: Panelhoehe passend zu maxRowCount=12. -->
							<f:GridContainerItemLayoutData columns="12" minRows="11"/>
						</layoutData>
						<headerToolbar>
							<OverflowToolbar id="tpaToolbar" height="3.25rem">
								<Avatar id="tpaAvatar" src="sap-icon://shipping-status" displaySize="XS" backgroundColor="Accent7"/>
								<Title id="tpaTitle" text="{i18n>tpaCardTitle}" level="H3" titleStyle="H3"/>
								<ToolbarSpacer id="tpaSpacer"/>
								<Button
									id="tpaColumnsButton"
									icon="sap-icon://action-settings"
									tooltip="{i18n>columnsTooltip}"
									type="Transparent"
									press=".onOpenTpaColumns"/>
							</OverflowToolbar>
						</headerToolbar>
						<content>
							<!--
								Spaltenreihenfolge bewusst nach Befuellung sortiert: die
								ersten acht Spalten sind standardmaessig sichtbar. Werk,
								MeasurementUnit, BestBeforeDate, ReferenceNumber,
								ReferenceDate und CreationDate werden vom Sync-Report nie
								befuellt (HiLIS liefert sie nicht, siehe CLAUDE.md O-01)
								und stehen deshalb hinten in der ausgeblendeten Gruppe.
							-->
							<t:Table
								id="idTpaTable"
								rows="{path: 'tpaModel>/Tpa', parameters: {$count: true}, sorter: {path: 'OrderNumber'}}"
								selectionMode="None"
								ariaLabelledBy="tpaTitle">
								<t:rowMode>
									<rm:Auto maxRowCount="12"/>
								</t:rowMode>
								<t:columns>
									<t:Column id="idTpaOrderNumberColumn" width="10rem" sortProperty="OrderNumber">
										<Label id="tpaLblOrderNumber" text="{i18n>colOrderNumber}"/>
										<t:template>
											<Text id="tpaTxtOrderNumber" text="{tpaModel>OrderNumber}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idTpaOrderLineColumn" width="7rem">
										<Label id="tpaLblOrderLine" text="{i18n>colOrderLineNumber}"/>
										<t:template>
											<Text id="tpaTxtOrderLine" text="{path: 'tpaModel>OrderLineNumber', formatter: '.formatter.dashIfEmpty'}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idTpaItemColumn" width="12rem" sortProperty="ItemNumber">
										<Label id="tpaLblItem" text="{i18n>colItemNumber}"/>
										<t:template>
											<Text id="tpaTxtItem" text="{path: 'tpaModel>ItemNumber', formatter: '.formatter.dashIfEmpty'}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idTpaMengeColumn" width="8rem" hAlign="End">
										<Label id="tpaLblMenge" text="{i18n>colMenge}"/>
										<t:template>
											<Text id="tpaTxtMenge" text="{path: 'tpaModel>Menge', formatter: '.formatter.quantityOrDash'}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idTpaBatchColumn" width="9rem">
										<Label id="tpaLblBatch" text="{i18n>colBatchNumber}"/>
										<t:template>
											<Text id="tpaTxtBatch" text="{path: 'tpaModel>BatchNumber', formatter: '.formatter.dashIfEmpty'}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idTpaLineStatusColumn" width="10rem" sortProperty="LineStatus">
										<Label id="tpaLblLineStatus" text="{i18n>colLineStatus}"/>
										<t:template>
											<ObjectStatus
												id="idTpaLineStatusObjectStatus"
												text="{path: 'tpaModel>LineStatus', formatter: '.formatter.dashIfEmpty'}"
												state="{path: 'tpaModel>LineStatus', formatter: '.formatter.orderStatusState'}"
												icon="{path: 'tpaModel>LineStatus', formatter: '.formatter.orderStatusIcon'}"/>
										</t:template>
									</t:Column>
									<t:Column id="idTpaOrderStatusColumn" width="10rem" sortProperty="OrderStatus">
										<Label id="tpaLblOrderStatus" text="{i18n>colOrderStatus}"/>
										<t:template>
											<Text id="tpaTxtOrderStatus" text="{path: 'tpaModel>OrderStatus', formatter: '.formatter.dashIfEmpty'}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idTpaLastSyncColumn" width="12rem" sortProperty="LastSyncAt">
										<Label id="tpaLblLastSync" text="{i18n>colLastSyncAt}"/>
										<t:template>
											<Text id="tpaTxtLastSync" text="{tpaModel>LastSyncAt}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idTpaOrderTypeColumn" width="9rem">
										<Label id="tpaLblOrderType" text="{i18n>colOrderType}"/>
										<t:template>
											<Text id="tpaTxtOrderType" text="{tpaModel>OrderType}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idTpaWerkColumn" width="6rem">
										<Label id="tpaLblWerk" text="{i18n>colWerk}"/>
										<t:template>
											<Text id="tpaTxtWerk" text="{tpaModel>Werk}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idTpaUomColumn" width="8rem">
										<Label id="tpaLblUom" text="{i18n>colMeasurementUnit}"/>
										<t:template>
											<Text id="tpaTxtUom" text="{tpaModel>MeasurementUnit}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idTpaBbdColumn" width="8rem">
										<Label id="tpaLblBbd" text="{i18n>colBestBeforeDate}"/>
										<t:template>
											<Text id="tpaTxtBbd" text="{tpaModel>BestBeforeDate}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idTpaRefNumberColumn" width="10rem">
										<Label id="tpaLblRefNumber" text="{i18n>colReferenceNumber}"/>
										<t:template>
											<Text id="tpaTxtRefNumber" text="{tpaModel>ReferenceNumber}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idTpaRefDateColumn" width="9rem">
										<Label id="tpaLblRefDate" text="{i18n>colReferenceDate}"/>
										<t:template>
											<Text id="tpaTxtRefDate" text="{tpaModel>ReferenceDate}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idTpaCreationDateColumn" width="11rem">
										<Label id="tpaLblCreationDate" text="{i18n>colCreationDate}"/>
										<t:template>
											<Text id="tpaTxtCreationDate" text="{tpaModel>CreationDate}" wrapping="false"/>
										</t:template>
									</t:Column>
								</t:columns>
							</t:Table>
						</content>
					</Panel>
				</f:GridContainer>
				<Title id="outboundHeading" text="{i18n>groupOutbound}" level="H2" titleStyle="H2" class="sapUiLargeMarginTop sapUiSmallMarginBottom"/>
				<f:GridContainer id="outboundGrid" snapToRow="true">
					<f:layout>
						<f:GridContainerSettings columns="12" minColumnSize="4rem" maxColumnSize="6rem" rowSize="2rem" gap="1rem"/>
					</f:layout>
					<f:layoutM>
						<f:GridContainerSettings columns="4" minColumnSize="3.5rem" maxColumnSize="6rem" rowSize="2rem" gap="0.75rem"/>
					</f:layoutM>
					<f:layoutS>
						<f:GridContainerSettings columns="4" minColumnSize="3.5rem" maxColumnSize="6rem" rowSize="2rem" gap="0.75rem"/>
					</f:layoutS>

					<!--
						PROZESSACHSE Warenausgang. Ausgewaehlt wird ueber den Praefix von
						HistoryType ("OB_"), nicht ueber Textmuster in der Meldung: der
						Praefix ist der einzige strukturierte Prozesstraeger, den die
						Tabelle hat (IB_ Wareneingang, OB_ Warenausgang, ITEM_
						Materialstamm). Der Filter laeuft serverseitig als
						startswith(HistoryType,'OB_').

						Anders als die Panels der Gruppe "Meldungen nach Typ" zeigt dieses
						ALLE Meldungstypen - E, W und S nebeneinander. Das ist der Sinn der
						Prozesssicht: was passiert im Warenausgang, unabhaengig davon, wie
						schlimm es ist. Die Typ-Spalte traegt den Zustand.

						ZWEI QUELLEN, mit ODER verknuepft: der Praefix OB_ und ein
						Wortmarker im Meldungstext. ZCL_ZLE_AUST_OB_TRIGGER setzt
						HISTORY_TYPE in KEINEM seiner neun Log-Aufrufe (nur die
						Consumer-Ebene ZCL_ZLE_AUST_OUTBOUND tut es) - sechs dieser
						neun tragen aber "Pick" oder "VSOLA" im Text, und beide
						Woerter kommen im Einlager-Trigger nicht vor.

						⚠ Der Marker ordnet nur ZU, nie FALSCH zu. Drei Meldungen sind
						in beiden Richtungen zeichengleich (Stammdaten nicht lesbar,
						ME-Abweichung, Verbindungsfehler im Storno) - die tragen keinen
						Marker und bleiben unzugeordnet, statt geraten zu werden. Der
						zweite Zaehler in der Kopfzeile macht genau diese Luecke sichtbar,
						statt sie zu verstecken - er zaehlt die Saetze ohne
						Prozesszuordnung, die in KEINER Prozessgruppe erscheinen koennen.
					-->
					<Panel id="outboundMsgPanel" height="100%">
						<layoutData>
							<!-- Siehe appLogPanel: Panelhoehe passend zu maxRowCount=12. -->
							<f:GridContainerItemLayoutData columns="12" minRows="11"/>
						</layoutData>
						<headerToolbar>
							<OverflowToolbar id="outboundMsgToolbar" height="3.25rem">
								<Avatar id="outboundMsgAvatar" src="sap-icon://upload-to-cloud" displaySize="XS" backgroundColor="Accent1"/>
								<Title id="outboundMsgTitle" text="{i18n>outboundMsgPanelTitle}" level="H3" titleStyle="H3"/>
								<ToolbarSpacer id="outboundMsgSpacer"/>
								<ObjectStatus
									id="idOutboundMsgCountObjectStatus"
									state="Information"
									icon="sap-icon://message-information"
									text="{ui>/kpi/waMeldungen} {i18n>outboundMsgPanelHint}"/>
								<ObjectStatus
									id="idNoProcessCountOutStatus"
									state="Warning"
									icon="sap-icon://alert"
									text="{ui>/kpi/ohneProzess} {i18n>noProcessHint}"/>
								<Button
									id="outboundMsgColumnsButton"
									icon="sap-icon://action-settings"
									tooltip="{i18n>columnsTooltip}"
									type="Transparent"
									press=".onOpenInboundMsgColumns"/>
							</OverflowToolbar>
						</headerToolbar>
						<content>
							<t:Table
								id="idOutboundMsgTable"
								rows="{path: 'mainModel>/AppLog', parameters: {$count: true}, filters: {and: false, filters: [{path: 'HistoryType', operator: 'StartsWith', value1: 'OB_'}, {path: 'Message', operator: 'Contains', value1: 'Pick'}, {path: 'Message', operator: 'Contains', value1: 'VSOLA'}]}, sorter: {path: 'CreatedAt', descending: true}}"
								selectionMode="None"
								ariaLabelledBy="outboundMsgTitle">
								<t:rowMode>
									<rm:Auto maxRowCount="12"/>
								</t:rowMode>
								<t:columns>
									<t:Column id="idOutboundMsgCreatedAtColumn" width="8rem" sortProperty="CreatedAt">
										<Label id="omLblCreatedAt" text="{i18n>colCreatedAt}"/>
										<t:template>
											<Text id="omTxtCreatedAt" text="{mainModel>CreatedAt}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idOutboundMsgTypeColumn" width="7rem" sortProperty="LogType">
										<Label id="omLblLogType" text="{i18n>colLogType}"/>
										<t:template>
											<ObjectStatus
												id="idOutboundMsgTypeObjectStatus"
												text="{mainModel>LogType}"
												state="{path: 'mainModel>LogType', formatter: '.formatter.logTypeState'}"
												icon="{path: 'mainModel>LogType', formatter: '.formatter.logTypeIcon'}"/>
										</t:template>
									</t:Column>
									<t:Column id="idOutboundMsgMessageColumn" minWidth="320">
										<Label id="omLblMessage" text="{i18n>colMessage}"/>
										<t:template>
											<Text id="omTxtMessage" text="{path: 'mainModel>Message', formatter: '.formatter.messageShort'}" wrapping="false" tooltip="{mainModel>Message}"/>
										</t:template>
									</t:Column>
									<t:Column id="idOutboundMsgItemColumn" width="12rem" sortProperty="ItemNumber">
										<Label id="omLblItem" text="{i18n>colItemNumber}"/>
										<t:template>
											<Text id="omTxtItem" text="{path: 'mainModel>ItemNumber', formatter: '.formatter.dashIfEmpty'}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idOutboundMsgTpaColumn" width="11rem" sortProperty="TpaNumber">
										<Label id="omLblTpa" text="{i18n>colTpaNumber}"/>
										<t:template>
											<Text id="omTxtTpa" text="{path: 'mainModel>TpaNumber', formatter: '.formatter.dashIfEmpty'}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idOutboundMsgProcessColumn" width="10rem" sortProperty="HistoryType">
										<Label id="omLblHistory" text="{i18n>colHistoryType}"/>
										<t:template>
											<Text id="omTxtHistory" text="{mainModel>HistoryType}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idOutboundMsgLineColumn" width="7rem">
										<Label id="omLblLine" text="{i18n>colOrderLineNr}"/>
										<t:template>
											<Text id="omTxtLine" text="{path: 'mainModel>OrderLineNr', formatter: '.formatter.dashIfEmpty'}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idOutboundMsgHttpColumn" width="7rem" hAlign="End" sortProperty="HttpStatus">
										<Label id="omLblHttp" text="{i18n>colHttpStatus}"/>
										<t:template>
											<Text id="omTxtHttp" text="{mainModel>HttpStatus}" wrapping="false"/>
										</t:template>
									</t:Column>
								</t:columns>
							</t:Table>
						</content>
					</Panel>
				</f:GridContainer>
				<Title id="errorHeading" text="{i18n>groupErrors}" level="H2" titleStyle="H2" class="sapUiLargeMarginTop sapUiSmallMarginBottom"/>
				<f:GridContainer id="errorGrid" snapToRow="true">
					<f:layout>
						<f:GridContainerSettings columns="12" minColumnSize="4rem" maxColumnSize="6rem" rowSize="2rem" gap="1rem"/>
					</f:layout>
					<f:layoutM>
						<f:GridContainerSettings columns="4" minColumnSize="3.5rem" maxColumnSize="6rem" rowSize="2rem" gap="0.75rem"/>
					</f:layoutM>
					<f:layoutS>
						<f:GridContainerSettings columns="4" minColumnSize="3.5rem" maxColumnSize="6rem" rowSize="2rem" gap="0.75rem"/>
					</f:layoutS>

					<!--
						WE- und WA-Panel sind bewusst ausgeblendet: das Backend
						protokolliert kein Merkmal, das Wareneingang von
						Warenausgang unterscheidet (CLAUDE.md, O-27). Zwei
						garantiert leere Panels waeren eine Verschlechterung.
						Das Flag ui>/showInOutSplit schaltet sie scharf, sobald
						die Daten es hergeben.
					-->
					<Panel id="inboundPanel" height="100%" visible="{ui>/showInOutSplit}">
						<layoutData>
							<f:GridContainerItemLayoutData columns="4" minRows="10"/>
						</layoutData>
						<headerToolbar>
							<OverflowToolbar id="inboundToolbar" height="3.25rem">
								<Avatar id="inboundAvatar" src="sap-icon://inbox" displaySize="XS" backgroundColor="Accent1"/>
								<Title id="inboundTitle" text="{i18n>inboundPanelTitle}" level="H3" titleStyle="H3"/>
								<ToolbarSpacer id="inboundSpacer"/>
							</OverflowToolbar>
						</headerToolbar>
						<content>
							<Text id="inboundPlaceholder" text="{i18n>panelPlaceholder}" class="sapUiSmallMargin"/>
						</content>
					</Panel>

					<Panel id="outboundPanel" height="100%" visible="{ui>/showInOutSplit}">
						<layoutData>
							<f:GridContainerItemLayoutData columns="4" minRows="10"/>
						</layoutData>
						<headerToolbar>
							<OverflowToolbar id="outboundToolbar" height="3.25rem">
								<Avatar id="outboundAvatar" src="sap-icon://outbox" displaySize="XS" backgroundColor="Accent2"/>
								<Title id="outboundTitle" text="{i18n>outboundPanelTitle}" level="H3" titleStyle="H3"/>
								<ToolbarSpacer id="outboundSpacer"/>
							</OverflowToolbar>
						</headerToolbar>
						<content>
							<Text id="outboundPlaceholder" text="{i18n>panelPlaceholder}" class="sapUiSmallMargin"/>
						</content>
					</Panel>

					<Panel id="techErrorPanel" height="100%">
						<layoutData>
							<f:GridContainerItemLayoutData columns="12" minRows="10"/>
						</layoutData>
						<headerToolbar>
							<OverflowToolbar id="techErrorToolbar" height="3.25rem">
								<Avatar id="techErrorAvatar" src="sap-icon://error" displaySize="XS" backgroundColor="Accent3"/>
								<Title id="techErrorTitle" text="{i18n>techErrorPanelTitle}" level="H3" titleStyle="H3"/>
								<ToolbarSpacer id="techErrorSpacer"/>
								<ObjectStatus
									id="idTechErrorCountObjectStatus"
									state="Error"
									icon="sap-icon://error"
									text="{ui>/kpi/fehler} {i18n>techErrorPanelHint}"/>
								<Button
									id="techErrorColumnsButton"
									icon="sap-icon://action-settings"
									tooltip="{i18n>columnsTooltip}"
									type="Transparent"
									press=".onOpenTechErrorColumns"/>
							</OverflowToolbar>
						</headerToolbar>
						<content>
							<t:Table
								id="idTechErrorTable"
								rows="{path: 'mainModel>/AppLog', parameters: {$count: true}, filters: [{path: 'LogType', operator: 'EQ', value1: 'E'}], sorter: {path: 'CreatedAt', descending: true}}"
								selectionMode="None"
								ariaLabelledBy="techErrorTitle">
								<t:rowMode>
									<rm:Auto maxRowCount="12"/>
								</t:rowMode>
								<t:columns>
									<t:Column id="idTechErrorCreatedAtColumn" width="8rem" sortProperty="CreatedAt">
										<Label id="teLblCreatedAt" text="{i18n>colCreatedAt}"/>
										<t:template>
											<Text id="teTxtCreatedAt" text="{mainModel>CreatedAt}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idTechErrorHttpColumn" width="7rem" hAlign="End" sortProperty="HttpStatus">
										<Label id="teLblHttp" text="{i18n>colHttpStatus}"/>
										<t:template>
											<Text id="teTxtHttp" text="{mainModel>HttpStatus}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idTechErrorMessageColumn" minWidth="320">
										<Label id="teLblMessage" text="{i18n>colMessage}"/>
										<t:template>
											<Text id="teTxtMessage" text="{path: 'mainModel>Message', formatter: '.formatter.messageShort'}" wrapping="false" tooltip="{mainModel>Message}"/>
										</t:template>
									</t:Column>
									<t:Column id="idTechErrorItemColumn" width="12rem" sortProperty="ItemNumber">
										<Label id="teLblItem" text="{i18n>colItemNumber}"/>
										<t:template>
											<Text id="teTxtItem" text="{mainModel>ItemNumber}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idTechErrorTpaColumn" width="11rem" sortProperty="TpaNumber">
										<Label id="teLblTpa" text="{i18n>colTpaNumber}"/>
										<t:template>
											<Text id="teTxtTpa" text="{mainModel>TpaNumber}" wrapping="false"/>
										</t:template>
									</t:Column>
								</t:columns>
							</t:Table>
						</content>
					</Panel>
					<!--
						Die Trennung laeuft ueber LogType, nicht ueber Textmuster:
						die fachlichen Abbrueche werden im Backend als 'W' geloggt
						(fuenf von sechs Abbruchstellen), technische Fehler als 'E'.
						Die alte OVP-Kachel filterte 'E' und zeigte damit genau die
						Komplementaermenge - daher die Rueckmeldung "man erkennt es
						nicht am Fehlertext". Siehe CLAUDE.md, O-25.
						Beide Filter laufen serverseitig, die Zaehler in den
						Kopfzeilen kommen aus model/KpiLoader.ts.
					-->
					<Panel id="abbruchPanel" height="100%">
						<layoutData>
							<f:GridContainerItemLayoutData columns="12" minRows="10"/>
						</layoutData>
						<headerToolbar>
							<OverflowToolbar id="abbruchToolbar" height="3.25rem">
								<Avatar id="abbruchAvatar" src="sap-icon://cancel" displaySize="XS" backgroundColor="Accent4"/>
								<Title id="abbruchTitle" text="{i18n>abortPanelTitle}" level="H3" titleStyle="H3"/>
								<ToolbarSpacer id="abbruchSpacer"/>
								<ObjectStatus
									id="idAbortCountObjectStatus"
									state="Warning"
									icon="sap-icon://alert"
									text="{ui>/kpi/nichtUebertragen} {i18n>abortPanelHint}"/>
								<Button
									id="abortColumnsButton"
									icon="sap-icon://action-settings"
									tooltip="{i18n>columnsTooltip}"
									type="Transparent"
									press=".onOpenAbortColumns"/>
							</OverflowToolbar>
						</headerToolbar>
						<content>
							<t:Table
								id="idAbortTable"
								rows="{path: 'mainModel>/AppLog', parameters: {$count: true}, filters: [{path: 'LogType', operator: 'EQ', value1: 'W'}], sorter: {path: 'CreatedAt', descending: true}}"
								selectionMode="None"
								ariaLabelledBy="abbruchTitle">
								<t:rowMode>
									<rm:Auto maxRowCount="12"/>
								</t:rowMode>
								<t:columns>
									<t:Column id="idAbortCreatedAtColumn" width="8rem" sortProperty="CreatedAt">
										<Label id="abLblCreatedAt" text="{i18n>colCreatedAt}"/>
										<t:template>
											<Text id="abTxtCreatedAt" text="{mainModel>CreatedAt}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idAbortItemColumn" width="12rem" sortProperty="ItemNumber">
										<Label id="abLblItem" text="{i18n>colItemNumber}"/>
										<t:template>
											<Text id="abTxtItem" text="{mainModel>ItemNumber}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idAbortMessageColumn" minWidth="320">
										<Label id="abLblMessage" text="{i18n>colMessage}"/>
										<t:template>
											<Text id="abTxtMessage" text="{path: 'mainModel>Message', formatter: '.formatter.messageShort'}" wrapping="false" tooltip="{mainModel>Message}"/>
										</t:template>
									</t:Column>
									<t:Column id="idAbortTpaColumn" width="11rem" sortProperty="TpaNumber">
										<Label id="abLblTpa" text="{i18n>colTpaNumber}"/>
										<t:template>
											<Text id="abTxtTpa" text="{mainModel>TpaNumber}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idAbortLineColumn" width="7rem">
										<Label id="abLblLine" text="{i18n>colOrderLineNr}"/>
										<t:template>
											<Text id="abTxtLine" text="{mainModel>OrderLineNr}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idAbortHistoryColumn" width="10rem" sortProperty="HistoryType">
										<Label id="abLblHistory" text="{i18n>colHistoryType}"/>
										<t:template>
											<Text id="abTxtHistory" text="{mainModel>HistoryType}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idAbortHttpColumn" width="7rem" hAlign="End" sortProperty="HttpStatus">
										<Label id="abLblHttp" text="{i18n>colHttpStatus}"/>
										<t:template>
											<Text id="abTxtHttp" text="{mainModel>HttpStatus}" wrapping="false"/>
										</t:template>
									</t:Column>
								</t:columns>
							</t:Table>
						</content>
					</Panel>
					<Panel id="appLogPanel" height="100%">
						<layoutData>
							<!--
								11 Rasterzeilen * 3rem - 1rem = 32rem. Das entspricht in
								compact-Dichte gerade den 12 Tabellenzeilen unten
								(maxRowCount), sodass kein Leerraum unter der Tabelle
								bleibt. Wer minRows erhoeht, muss maxRowCount mitziehen -
								sonst deckelt die Tabelle und der Leerraum kommt zurueck.
							-->
							<f:GridContainerItemLayoutData columns="12" minRows="11"/>
						</layoutData>
						<headerToolbar>
							<OverflowToolbar id="appLogToolbar" height="3.25rem">
								<Avatar id="appLogAvatar" src="sap-icon://sys-enter-2" displaySize="XS" backgroundColor="Accent8"/>
								<Title id="appLogTitle" text="{i18n>successPanelTitle}" level="H3" titleStyle="H3"/>
								<ToolbarSpacer id="appLogSpacer"/>
								<ObjectStatus
									id="idSuccessCountObjectStatus"
									state="Success"
									icon="sap-icon://sys-enter-2"
									text="{ui>/kpi/erfolge} {i18n>successPanelHint}"/>
								<Button
									id="appLogColumnsButton"
									icon="sap-icon://action-settings"
									tooltip="{i18n>columnsTooltip}"
									type="Transparent"
									press=".onOpenAppLogColumns"/>
							</OverflowToolbar>
						</headerToolbar>
						<content>
							<!--
								sap.ui.table.Table statt sap.m.Table: nur diese hat einen
								eigenen Scrollbar und dauerhaft fixierte Spaltenkoepfe.
								sap.m.Table scrollt mit der Seite, und ihr sticky-Feature
								wird von Grid-Layout-Containern unterdrueckt.
								rowMode-Aggregation statt visibleRowCountMode - Letzteres
								ist seit UI5 1.119 deprecated.
							-->
							<t:Table
								id="idAppLogTable"
								rows="{path: 'mainModel>/AppLog', parameters: {$count: true}, filters: [{path: 'LogType', operator: 'EQ', value1: 'S'}], sorter: {path: 'CreatedAt', descending: true}}"
								selectionMode="None"
								ariaLabelledBy="appLogTitle">
								<t:rowMode>
									<rm:Auto maxRowCount="12"/>
								</t:rowMode>
								<t:columns>
									<t:Column id="idAppLogCreatedAtColumn" width="8rem" sortProperty="CreatedAt">
										<Label id="alLblCreatedAt" text="{i18n>colCreatedAt}"/>
										<t:template>
											<Text id="alTxtCreatedAt" text="{mainModel>CreatedAt}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idAppLogTypeColumn" width="7rem" sortProperty="LogType">
										<Label id="alLblLogType" text="{i18n>colLogType}"/>
										<t:template>
											<ObjectStatus
												id="idAppLogTypeObjectStatus"
												text="{mainModel>LogType}"
												state="{path: 'mainModel>LogType', formatter: '.formatter.logTypeState'}"
												icon="{path: 'mainModel>LogType', formatter: '.formatter.logTypeIcon'}"/>
										</t:template>
									</t:Column>
									<t:Column id="idAppLogMessageColumn" minWidth="320">
										<Label id="alLblMessage" text="{i18n>colMessage}"/>
										<t:template>
											<Text id="alTxtMessage" text="{path: 'mainModel>Message', formatter: '.formatter.messageShort'}" wrapping="false" tooltip="{mainModel>Message}"/>
										</t:template>
									</t:Column>
									<t:Column id="idAppLogItemColumn" width="12rem" sortProperty="ItemNumber">
										<Label id="alLblItemNumber" text="{i18n>colItemNumber}"/>
										<t:template>
											<Text id="alTxtItemNumber" text="{mainModel>ItemNumber}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idAppLogTpaColumn" width="11rem" sortProperty="TpaNumber">
										<Label id="alLblTpaNumber" text="{i18n>colTpaNumber}"/>
										<t:template>
											<Text id="alTxtTpaNumber" text="{mainModel>TpaNumber}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idAppLogHistoryColumn" width="10rem" sortProperty="HistoryType">
										<Label id="alLblHistoryType" text="{i18n>colHistoryType}"/>
										<t:template>
											<Text id="alTxtHistoryType" text="{mainModel>HistoryType}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idAppLogLineColumn" width="7rem">
										<Label id="alLblOrderLineNr" text="{i18n>colOrderLineNr}"/>
										<t:template>
											<Text id="alTxtOrderLineNr" text="{mainModel>OrderLineNr}" wrapping="false"/>
										</t:template>
									</t:Column>
									<t:Column id="idAppLogHttpColumn" width="7rem" hAlign="End">
										<Label id="alLblHttpStatus" text="{i18n>colHttpStatus}"/>
										<t:template>
											<Text id="alTxtHttpStatus" text="{mainModel>HttpStatus}" wrapping="false"/>
										</t:template>
									</t:Column>
								</t:columns>
							</t:Table>
						</content>
					</Panel>
				</f:GridContainer>




			</VBox>
		</f:content>

	</f:DynamicPage>
</mvc:View>
