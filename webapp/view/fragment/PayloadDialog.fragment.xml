<!--
	JSON_PAYLOAD einer einzelnen Logzeile.

	Das Feld liegt seit jeher im OData-Service und war in der Oberflaeche
	NIRGENDS sichtbar. O-09 hatte das als nicht umsetzbar abgelegt - das war
	aber eine OVP-Beschraenkung (@UI.facets ist auf S/4HANA 758 nicht
	aktivierbar). In einer Freestyle-App ist es ein Dialog.

	TextArea statt Text, damit der Inhalt markiert und mit Strg+C kopiert werden
	kann - fuer eine Rueckfrage an Hoermann ist genau das der Nutzen. Ein
	eigener Kopier-Button waere navigator.clipboard, und das verbietet die
	Projektregel sap-no-navigator; der Gewinn waere ohnehin klein.
-->
<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">

	<Dialog
		id="payloadDialog"
		title="{detail>/payloadTitle}"
		contentWidth="52rem"
		contentHeight="32rem"
		resizable="true"
		draggable="true">

		<VBox id="payloadBox" class="sapUiSmallMargin">
			<Text id="payloadMessage" text="{detail>/payloadMessage}" class="sapUiTinyMarginBottom"/>
			<TextArea
				id="payloadText"
				value="{detail>/payload}"
				editable="false"
				growing="{= !!${detail>/payloadHtml} }"
				height="{= ${detail>/payloadHtml} ? '' : '24rem' }"
				width="100%"
				visible="{= !!${detail>/payload} }"/>
			<!-- HTML-Fehlerseite aus HiLIS formatiert. Das HTML ist vorher in
			     model/HttpText.ts auf Struktur-Tags ohne Attribute reduziert,
			     FormattedText sanitisiert zusaetzlich. -->
			<Title id="payloadHtmlTitle" text="{i18n>payloadResponse}" level="H5"
				class="sapUiSmallMarginTop sapUiTinyMarginBottom"
				visible="{= !!${detail>/payloadHtml} }"/>
			<!-- Kein eigener Scrollbereich: Request und Antwort wachsen mit dem
			     Inhalt, gescrollt wird der Dialog als Ganzes. -->
			<FormattedText id="payloadHtml" htmlText="{detail>/payloadHtml}"
				visible="{= !!${detail>/payloadHtml} }"/>
		</VBox>

		<endButton>
			<Button
				id="payloadClose"
				text="{i18n>popClose}"
				press=".onPayloadClose"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>
