<!--
	SICHERHEITSAUFLAGE (Vorfall 22.07.2026) - BITTE NICHT AUFWEICHEN:

	Die E-Mail-Adressen werden ausschliesslich als Text angezeigt.
	Kein sap.m.Link, kein href, kein targetUri, kein press-Handler,
	kein sap.m.URLHelper.triggerEmail, kein DOM-Zugriff.

	Grund: Ein mailto:-Klick aus dieser Kachel hat einen bereits offenen,
	unabhaengigen Outlook-Entwurf an einen anderen Empfaenger tatsaechlich
	VERSENDET (bestaetigter Vorfall). Ursache liegt in Outlooks DDE/COM-
	Handshake und ist von hier aus nicht kontrollierbar.

	Der Anwender kopiert die Adresse manuell.

	ZUM AUFBAU: Bewusst OHNE headerToolbar. Lag der gesamte Inhalt im
	Panel-Header, blieben die unteren Ecken eckig - der Header rendert bis
	an die Panelkante. Alles im content zu haben gibt die runden Ecken und
	bleibt trotzdem eine einzeilige, schmale Leiste.
-->
<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<Panel id="idContactPanel" class="sapUiTinyMarginBottom">
		<content>
			<HBox id="idContactHBox" alignItems="Center" wrap="Wrap" class="sapUiSmallMargin">
				<Avatar
					id="idContactAvatar"
					src="sap-icon://group"
					displaySize="XS"
					backgroundColor="Accent8"
					class="sapUiTinyMarginEnd"/>
				<Title
					id="idKontakteTitle"
					text="{i18n>kontakteCardTitle}"
					level="H3"
					titleStyle="H3"
					class="sapUiMediumMarginEnd"/>

				<core:Icon id="idContactPmIcon" src="sap-icon://person-placeholder" class="sapUiTinyMarginEnd"/>
				<Text id="contactTextPm" text="{i18n>kontaktHoermannPm}" class="sapUiMediumMarginEnd"/>

				<core:Icon id="idContactWmsIcon" src="sap-icon://headset" class="sapUiTinyMarginEnd"/>
				<Text id="contactTextWms" text="{i18n>kontaktWmsSupport}" class="sapUiMediumMarginEnd"/>

				<core:Icon id="idContactItIcon" src="sap-icon://it-system" class="sapUiTinyMarginEnd"/>
				<Text id="contactTextIt" text="{i18n>kontaktKroschkeIt}"/>
			</HBox>
		</content>
	</Panel>
</core:FragmentDefinition>
