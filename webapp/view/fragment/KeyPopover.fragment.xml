<!--
	Detailsicht zu einer TPA- oder Materialnummer.

	ZWEI PANELS, UND DAS IST ABSICHT:
	  SAP      - Stammdaten bzw. TA-Positionen. Der Grund, warum jemand das
	             Popover oeffnet, deshalb aufgeklappt.
	  Verlauf  - NUR fuer die Kaskadensicht und als Rueckfallebene, wenn der
	             Lookup-Service nicht antwortet. Bei vorhandenen SAP-Daten
	             ist er ausgeblendet: er wiederholte die Tabelle dahinter.
	             Der JSON_PAYLOAD ist seit dem 27.08.2026 direkt in der
	             Meldungszelle erreichbar, nicht mehr nur hier.

	⚠ Ein drittes Panel mit den Pufferzeilen aus ZLE_AUST_TPA gab es bis zum
	  27.08.2026. Es ist entfallen: seit die TA-Positionen aus LTAK/LTAP da
	  sind, zeigte es dieselbe Sache aus der schwaecheren Quelle - HiLIS'
	  Sicht statt SAPs -, und den Puffer gibt es ohnehin als eigenen Reiter.
	  Nebeneffekt: eine OData-Abfrage weniger je Oeffnen.

	Gebunden wird gegen das JSON-Modell "detail", nicht direkt gegen OData -
	die Daten werden im Controller geladen, sortiert und aufbereitet. Zwei
	OData-Listenbindungen in einem Popover waeren schwerer zu steuern und
	wuerden bei jedem Oeffnen neu aufsetzen.
-->
<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:grid="sap.ui.layout.cssgrid">

	<!--
		placement="PreferredLeftOrFlip" statt "Auto": die Ankerzellen
		(Material, TPA-Nummer) sitzen in den RECHTEN Spalten, und bei 46rem
		Breite lief das Popover dort ueber den Bildschirmrand hinaus. Links
		bevorzugen, kippen wenn dort kein Platz ist.
	-->
	<ResponsivePopover
		id="keyPopover"
		title="{detail>/title}"
		placement="PreferredLeftOrFlip"
		contentWidth="46rem"
		resizable="true"
		verticalScrolling="true">

		<customHeader>
			<Bar id="keyPopoverBar">
				<!--
					⚠ Titel DIREKT in contentLeft, nicht in einer VBox.
					sap.m.Bar verteilt die Breiten auf links/mitte/rechts; ein
					Flex-Container ohne eigene Breite kollabiert dabei auf
					null. Der Titel stand vorher in einer VBox und war
					deshalb NIE sichtbar - der Kopf zeigte nur das X aus
					contentRight. Der Untertitel ist mit entfallen: die
					Panel-Ueberschriften darunter sagen ohnehin, was zu sehen
					ist.
				-->
				<contentLeft>
					<Title id="keyPopoverTitle" text="{detail>/title}" level="H3" titleStyle="H5" class="sapUiTinyMarginBegin"/>
				</contentLeft>
				<contentRight>
					<Button
						id="keyPopoverClose"
						icon="sap-icon://decline"
						type="Transparent"
						tooltip="{i18n>popClose}"
						press=".onKeyPopoverClose"/>
				</contentRight>
			</Bar>
		</customHeader>

		<VBox id="keyPopoverContent" busy="{detail>/busy}" busyIndicatorDelay="0">

			<Panel
				id="keyPopoverLogPanel"
				headerText="{detail>/logHeader}"
				expandable="true"
				expanded="true"
				visible="{detail>/logVisible}">
				<List
					id="keyPopoverLogList"
					items="{detail>/log}"
					noDataText="{i18n>popNoLog}"
					showSeparators="Inner">
					<ObjectListItem
						id="keyPopoverLogItem"
						title="{detail>message}"
						intro="{detail>stamp}"
						type="{= ${detail>payload} ? 'Active' : 'Inactive' }"
						press=".onKeyPopoverLogPress">
						<firstStatus>
							<ObjectStatus
								id="keyPopoverLogStatus"
								text="{detail>logType}"
								state="{path: 'detail>logType', formatter: '.formatter.logTypeState'}"
								icon="{path: 'detail>logType', formatter: '.formatter.logTypeIcon'}"/>
						</firstStatus>
						<attributes>
							<ObjectAttribute id="keyPopoverLogProcess" text="{detail>process}"/>
							<ObjectAttribute id="keyPopoverLogHttp" text="{detail>http}"/>
							<ObjectAttribute id="keyPopoverLogLine" text="{detail>line}"/>
							<ObjectAttribute id="keyPopoverLogPayloadHint" text="{i18n>popPayloadHint}" visible="{= !!${detail>payload} }"/>
						</attributes>
					</ObjectListItem>
				</List>
			</Panel>

			<Panel
				id="keyPopoverSapPanel"
				headerText="{detail>/sap/header}"
				expandable="true"
				expanded="true"
				visible="{= ${detail>/sap/available} === true }">

				<!--
					RASTER STATT LISTE. Eine Liste gibt jedem Feld eine eigene
					volle Zeile - bei Werten wie "999", "1", "0" oder "02" ist
					das viel Hoehe fuer wenig Inhalt, und der Kopf schob die
					Positionen aus dem Bild.

					"repeat(auto-fit, minmax(15rem, 1fr))" braucht dafuer KEINE
					Breakpoints: der Browser legt so viele Spalten an, wie bei
					15rem Mindestbreite hineinpassen. Im 46rem breiten Popover
					sind das zwei, auf dem Telefon (wo der ResponsivePopover zum
					Vollbild-Dialog wird) eine.
				-->
				<grid:CSSGrid
					id="keyPopoverSapFieldGrid"
					gridTemplateColumns="repeat(auto-fit, minmax(15rem, 1fr))"
					gridGap="0.5rem 2rem"
					class="sapUiSmallMargin"
					items="{detail>/sap/fields}"
					visible="{= ${detail>/sap/fields}.length > 0 }">
					<HBox id="keyPopoverSapFieldBox" justifyContent="SpaceBetween" alignItems="Center">
						<Label id="keyPopoverSapFieldLabel" text="{detail>label}"/>
						<ObjectStatus
							id="keyPopoverSapFieldValue"
							text="{detail>value}"
							state="{detail>state}"
							class="sapUiTinyMarginBegin"/>
					</HBox>
				</grid:CSSGrid>

			</Panel>

			<!--
				Zweites Panel: die Positionen. LTAK-Felder stehen im Panel
				darueber, weil sie je TA EINMAL gelten - stuende die
				Bewegungsart als Positionsattribut, waere sie bei jeder Zeile
				derselbe Wert, und fuer Ersteller, Anlagezeit oder
				Materialbeleg waere in einer Positionszeile gar kein Platz.
			-->
			<Panel
				id="keyPopoverSapRowPanel"
				headerText="{detail>/sap/rowsHeader}"
				expandable="true"
				expanded="true"
				visible="{= ${detail>/sap/rows}.length > 0 }">
				<!--
					⚠ templateShareable: false ist an BEIDEN inneren Bindungen
					(lines, attrs) PFLICHT, nicht Kosmetik: sie sitzen INNERHALB
					des Zeilen-Templates und werden je Position mitgeklont. Ohne
					die Angabe weiss UI5 nicht, ob es die Kopie zerstoeren darf,
					laesst sie stehen und warnt vor Speicherleck und doppelten IDs.

					ObjectListItem war hier nicht mehr das richtige Steuerelement:
					es stellt "intro" UEBER den Titel (der Materialkurztext stand
					also grau und klein ueber der Kennung, obwohl er der Text ist,
					den man liest) und legt jedes ObjectAttribute auf eine eigene
					Zeile - sechs Zeilen fuer sechs kurze Werte.
				-->
				<List
					id="keyPopoverSapRowList"
					items="{detail>/sap/rows}"
					showSeparators="Inner">
					<CustomListItem id="keyPopoverSapRowItem" type="Inactive">
						<VBox id="keyPopoverSapRowBox" class="sapUiSmallMargin">

							<HBox id="keyPopoverSapRowHead" justifyContent="SpaceBetween" alignItems="Start">
								<VBox id="keyPopoverSapRowIdent">
									<Title
										id="keyPopoverSapRowTitle"
										text="{detail>title}"
										level="H4"
										titleStyle="H6"/>
									<Text
										id="keyPopoverSapRowIntro"
										text="{detail>intro}"
										visible="{= !!${detail>intro} }"/>
								</VBox>
								<ObjectStatus
									id="keyPopoverSapRowStatus"
									text="{detail>status}"
									state="{detail>statusState}"/>
							</HBox>

							<VBox
								id="keyPopoverSapRowLines"
								class="sapUiTinyMarginTop"
								items="{path: 'detail>lines', templateShareable: false}">
								<Text id="keyPopoverSapRowLine" text="{detail>}"/>
							</VBox>

							<!--
								Engeres Raster als im Kopf: Datum, Charge und Drucker
								sind kurz, da passen bei 12rem drei Spalten nebeneinander.
							-->
							<grid:CSSGrid
								id="keyPopoverSapRowAttrGrid"
								gridTemplateColumns="repeat(auto-fit, minmax(12rem, 1fr))"
								gridGap="0.25rem 1.5rem"
								class="sapUiTinyMarginTop"
								items="{path: 'detail>attrs', templateShareable: false}">
								<HBox id="keyPopoverSapRowAttrBox" justifyContent="SpaceBetween" alignItems="Center">
									<Label id="keyPopoverSapRowAttrLabel" text="{detail>label}"/>
									<Text
										id="keyPopoverSapRowAttrValue"
										text="{detail>value}"
										class="sapUiTinyMarginBegin"/>
								</HBox>
							</grid:CSSGrid>

						</VBox>
					</CustomListItem>
				</List>
			</Panel>

			<!--
				An den TEXT gebunden, nicht an available: in der Kaskadensicht
				gibt es gar keinen SAP-Abruf, available ist dort false und der
				Hinweis leer - die Leiste erschien trotzdem, als blaue Zeile
				ohne Inhalt.
			-->
			<MessageStrip
				id="keyPopoverSapHint"
				text="{detail>/sap/hint}"
				type="Information"
				showIcon="true"
				visible="{= ${detail>/sap/hint} !== '' }"
				class="sapUiSmallMargin"/>

		</VBox>
	</ResponsivePopover>
</core:FragmentDefinition>
